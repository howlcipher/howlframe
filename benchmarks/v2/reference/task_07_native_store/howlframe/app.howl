(do
  (defun increment_counter ((key string)) int
    (do
      (store_open counter_store "memory://counter")
      (let (val (store_get counter_store key))
        (try_let (count (map_get val "count"))
          (catch err
            (do (store_put counter_store key (dict ("count" 1))) (return 1)))
          (let (newval (+ count 1))
            (do (store_put counter_store key (dict ("count" newval))) (return newval)))))))
  (let (first (increment_counter "visits"))
    (let (second (increment_counter "visits"))
      (if (!= second 2)
        (do (stderr "Failed") (exit 1))
        (print "Pass")))))
