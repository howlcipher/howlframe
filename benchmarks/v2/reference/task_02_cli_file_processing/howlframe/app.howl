(cli_app
  (try_let (filepath (cli_args 0))
    (catch err
      (do
        (stderr "Error: File not found")
        (exit 1)
      )
    )
    (try_let (content (read_file filepath))
      (catch err
        (do
          (stderr "Error: File not found")
          (exit 1)
        )
      )
      (let (lines (str_split (bytes_to_string content) "\n"))
        (for line lines
          (if (!= line "")
            (print "Hello," line "!")
          )
        )
      )
    )
  )
)
