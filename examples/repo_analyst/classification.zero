(module
  (export (defun is_zero_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match "\\.zero$" path))))

  (export (defun is_go_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match "\\.go$" path))))

  (export (defun is_python_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match "\\.py$" path))))

  (export (defun is_javascript_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match "\\.[cm]?jsx?$" path))))

  (export (defun is_typescript_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match "\\.[cm]?tsx?$" path))))

  (export (defun is_configuration_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match
      "(?i)(\\.(json|ya?ml|toml|ini|conf)$|(^|/)(Dockerfile|Makefile|go\\.mod|go\\.sum|\\.gitignore))"
      path))))

  (export (defun is_test_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match
      "(?i)((^|/)(tests?|specs?)(/|$)|(_test\\.[^/]+|\\.(test|spec)\\.[^/]+)$)"
      path))))

  (export (defun is_likely_entry_point (path)
    (type_hints (path string) (return bool))
    (return (regex_match
      "(?i)(^|/)(main\\.(zero|go|py|js|ts)|index\\.(js|ts)|zero\\.go|repo_analyst\\.zero)$"
      path))))

  (export (defun is_text_file (path)
    (type_hints (path string) (return bool))
    (return (regex_match
      "(?i)(\\.(zero|go|py|[cm]?jsx?|[cm]?tsx?|json|ya?ml|toml|ini|conf|md|txt|rst|html?|css|scss|sh|bash|zsh|fish|sql|xml|csv)$|(^|/)(Dockerfile|Makefile|go\\.mod|go\\.sum|\\.gitignore|LICENSE|README))"
      path))))
)
