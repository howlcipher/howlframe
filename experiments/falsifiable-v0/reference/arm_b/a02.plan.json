{
  "schema": "howlframe.exp.plan/v0",
  "steps": [
    {
      "action": "read_file",
      "path": "evidence/checks.json",
      "format": "json",
      "as": "checks"
    },
    {
      "action": "read_file",
      "path": "evidence/version.kv",
      "format": "kv",
      "as": "version"
    },
    {
      "action": "read_file",
      "path": "evidence/note.txt",
      "format": "text",
      "as": "note"
    },
    {
      "action": "filter",
      "from": "checks",
      "where": {
        "field": "status",
        "op": "eq",
        "value": "PASS"
      },
      "as": "selected"
    },
    {
      "action": "if",
      "cond": {
        "op": "all",
        "var": "checks",
        "field": "status",
        "value": "PASS"
      },
      "then": [
        {
          "action": "if",
          "cond": {
            "op": "semver_gt",
            "var": "version.proposed",
            "value": {
              "$var": "version.current"
            }
          },
          "then": [
            {
              "action": "write_record",
              "path": "out/release.json",
              "record": {
                "batch": "02",
                "selected": {
                  "$var": "selected"
                }
              }
            }
          ],
          "else": [
            {
              "action": "request_approval",
              "reason": "blocked",
              "summary": {}
            }
          ]
        }
      ],
      "else": [
        {
          "action": "request_approval",
          "reason": "blocked",
          "summary": {}
        }
      ]
    }
  ]
}
