(do
 (let (cfg (read_json "in/config.json"))
  (write_file "out/result.txt"
   (str_join
    (map_list p (lines (read_file "in/paths.txt"))
     (let (v cfg ok true)
      (do
       (for k (str_split p ".")
        (if (and (starts_with (encode_json v) "{") (map_has v k)) (set v (get v k)) (do (set ok false) (break))))
       (if ok (encode_json v) "missing"))))
    "\n"))))
