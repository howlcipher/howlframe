(do
 (let (f (read_json "in/flat.json") out (dict))
  (do
   (for k (map_keys f)
    (let (ps (str_split k ".") n (list_len ps) node out)
     (do
      (for p (list_slice ps 0 (- n 1))
       (do (when (is_nil (get node p)) (map_set node p (dict))) (set node (get node p))))
      (map_set node (list_get ps (- n 1)) (get f k)))))
   (write_json "out/result.json" out))))
