(do
 (defun flat ((d any) (pre string) (out any)) any
  (do
   (for k (map_keys d)
    (let (v (map_get d k))
     (if (and (starts_with (encode_json v) "{") (!= (encode_json v) "{}")) (call flat v (str pre k ".") out) (map_set out (str pre k) v))))
   (return out)))
 (write_file "out/result.json" (encode_json (call flat (parse_json Any (read_text "in/nested.json")) "" (dict)))))
