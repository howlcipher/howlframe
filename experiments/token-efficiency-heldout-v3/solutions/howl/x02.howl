(do
 (defun merge ((a any) (b any)) any
  (do
   (for k (map_keys b)
    (let (x (map_get a k) y (map_get b k))
     (map_set a k (if (and (starts_with (encode_json x) "{") (starts_with (encode_json y) "{")) (call merge x y) y))))
   (return a)))
 (write_file "out/result.json"
  (encode_json (call merge (parse_json Any (read_text "in/base.json")) (parse_json Any (read_text "in/override.json"))))))
