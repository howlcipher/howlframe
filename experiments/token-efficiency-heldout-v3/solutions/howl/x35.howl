(do
 (let (deps (parse_json Any (read_text "in/deps.json")) ks (sort (map_keys deps)) out (list))
  (do
   (while (< (list_len out) (list_len ks))
    (for t ks
     (when (and (not (list_contains out t)) (all d (map_get deps t) (list_contains out d))) (do (append out t) (break)))))
   (write_file "out/result.json" (encode_json out)))))
