(do
 (write_file "out/result.txt"
  (str_join
   (map_list l (lines (read_file "in/ids.txt"))
    (let (t 0 i 0)
     (do
      (for c (reverse (str_split l ""))
       (let (d (* (to_int c) (+ 1 (% i 2))))
        (do (set t (+ t (if (> d 9) (- d 9) d))) (inc i))))
      (str l (if (= (% t 10) 0) " valid" " invalid")))))
   "\n")))
