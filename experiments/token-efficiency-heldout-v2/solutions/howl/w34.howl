(do
 (let (g (map_list l (lines (read_file "in/maze.txt")) (str_split l "")) r 0 c 0 w 0 i 0)
  (do
   (for row g
    (do (when (list_contains row "S") (do (set r i) (set c (index_of row "S")))) (inc i)))
   (for d (list (list (- 0 1) 0) (list 1 0) (list 0 (- 0 1)) (list 0 1))
    (let (y (+ r (list_get d 0)) x (+ c (list_get d 1)))
     (when (and (and (>= y 0) (< y (list_len g))) (and (>= x 0) (< x (list_len (list_get g y)))))
      (when (= (list_get (list_get g y) x) "#") (inc w)))))
   (write_file "out/result.txt" (str r "," c " " w)))))
