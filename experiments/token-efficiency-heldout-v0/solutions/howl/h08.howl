(do
 (let (lines (lines (read_file "in/data.csv")) header (str_split (list_get lines 0) ",") col 0 i 0 total 0)
  (do
   (for h header (do (when (= h "amount") (set col i)) (inc i)))
   (set i 0)
   (for row lines
    (do (when (> i 0) (set total (+ total (to_int (list_get (str_split row ",") col))))) (inc i)))
   (write_file "out/result.txt" (to_string total)))))
