{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cv1-run-result/1",
  "title": "competitive-v1 agent run record",
  "description": "One agent session (task, arm, provider, repetition). Written by runner.py for every run, including runs that never started; nothing is dropped (protocol 7.9).",
  "type": "object",
  "required": ["schema", "run_id", "task_id", "arm", "repetition", "agent", "cli_binary", "status", "end_reason",
               "started_utc", "ended_utc", "elapsed_s", "completion_handshake", "spend_usd", "model_calls",
               "tool_calls", "served_models", "first_request_surface_sha256", "acceptance_tests_sha256",
               "final_workspace_sha256", "wall_clock_limit_s", "limits", "infrastructure_rerun_of"],
  "properties": {
    "schema": {"const": "cv1-run-result/1"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "arm": {"enum": ["howlframe", "python", "go", "javascript"]},
    "repetition": {"type": "integer"},
    "agent": {"type": "object", "required": ["provider", "model", "effort", "cli"]},
    "cli_binary": {"type": "object", "required": ["path", "sha256"]},
    "status": {"enum": ["ended_by_agent", "not_completed_time", "not_completed_budget", "not_completed_tool_calls",
                        "infrastructure_failure", "not_started"]},
    "end_reason": {"enum": ["task_complete", "agent_exited", "not_completed_time", "not_completed_budget",
                            "not_completed_tool_calls", "infrastructure_failure", "admission_refused"]},
    "end_detail": {"type": ["string", "null"]},
    "started_utc": {"type": ["string", "null"]},
    "ended_utc": {"type": ["string", "null"]},
    "elapsed_s": {"type": "number"},
    "completion_handshake": {"type": "boolean"},
    "time_to_complete_s": {"type": ["number", "null"]},
    "spend_usd": {"type": "number"},
    "model_calls": {"type": "integer"},
    "tool_calls": {"type": "integer"},
    "served_models": {"type": "array", "items": {"type": "string"}},
    "first_request_surface_sha256": {"type": ["string", "null"]},
    "acceptance_tests_sha256": {"type": "object"},
    "final_workspace_sha256": {"type": "object"},
    "baseline_used": {"type": "boolean"},
    "wall_clock_limit_s": {"type": "number"},
    "limits": {"type": "object"},
    "infrastructure_rerun_of": {"type": ["string", "null"]},
    "human_interventions": {"type": "array", "description": "Filled in by the operator log; any entry makes the run not autonomous (H1)."}
  }
}
