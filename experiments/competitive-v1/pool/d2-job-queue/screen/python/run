#!/usr/bin/env python3
import argparse
import json
import os
import sys
import time
from urllib.parse import urlparse
from http.server import HTTPServer, BaseHTTPRequestHandler

class Engine:
    def __init__(self, store_path):
        self.store_path = store_path
        self.jobs = {}
        self.next_id = 1
        self.load()

    def load(self):
        if self.store_path and os.path.isfile(self.store_path):
            try:
                with open(self.store_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    self.jobs = data.get("jobs", {})
                    self.next_id = data.get("next_id", 1)
            except Exception:
                self.jobs = {}
                self.next_id = 1

    def save(self):
        if self.store_path:
            try:
                with open(self.store_path, "w", encoding="utf-8") as f:
                    json.dump({"jobs": self.jobs, "next_id": self.next_id}, f, indent=2)
            except Exception:
                pass

    def enqueue(self, body):
        if not isinstance(body, dict) or "topic" not in body or not body["topic"]:
            return 400, {"error": "invalid_payload"}

        job_id = f"job-{self.next_id}"
        self.next_id += 1

        job = {
            "job_id": job_id,
            "topic": str(body["topic"]),
            "payload": body.get("payload", {}),
            "priority": int(body.get("priority", 0)),
            "max_retries": int(body.get("max_retries", 3)),
            "lease_seconds": int(body.get("lease_seconds", 30)),
            "status": "pending",
            "attempts": 0,
            "leased_by": None,
            "lease_expires_at": None,
            "created_at": time.time()
        }
        self.jobs[job_id] = job
        self.save()
        return 201, job

    def lease(self, body):
        if not isinstance(body, dict) or "topic" not in body or "worker_id" not in body:
            return 400, {"error": "invalid_payload"}

        topic = body["topic"]
        worker_id = body["worker_id"]
        now = time.time()

        candidates = []
        for j in self.jobs.values():
            if j["topic"] != topic:
                continue
            if j["status"] == "pending":
                candidates.append(j)
            elif j["status"] == "leased" and j["lease_expires_at"] and now >= j["lease_expires_at"]:
                candidates.append(j)

        if not candidates:
            return 204, None

        # Sort: priority DESC, created_at ASC, job_id ASC
        candidates.sort(key=lambda j: (-j["priority"], j["created_at"], j["job_id"]))
        chosen = candidates[0]

        chosen["status"] = "leased"
        chosen["attempts"] += 1
        chosen["leased_by"] = worker_id
        chosen["lease_expires_at"] = now + chosen["lease_seconds"]

        self.save()
        return 200, chosen

    def ack(self, job_id, body):
        worker_id = body.get("worker_id") if isinstance(body, dict) else None
        if job_id not in self.jobs:
            return 404, {"error": "not_found"}

        job = self.jobs[job_id]
        if job["status"] != "leased" or job["leased_by"] != worker_id:
            return 409, {"error": "not_leased_by_worker"}

        job["status"] = "completed"
        self.save()
        return 200, {"status": "completed"}

    def fail(self, job_id, body):
        worker_id = body.get("worker_id") if isinstance(body, dict) else None
        if job_id not in self.jobs:
            return 404, {"error": "not_found"}

        job = self.jobs[job_id]
        if job["status"] != "leased" or job["leased_by"] != worker_id:
            return 409, {"error": "not_leased_by_worker"}

        if job["attempts"] >= job["max_retries"]:
            job["status"] = "dead_letter"
        else:
            job["status"] = "pending"

        job["leased_by"] = None
        job["lease_expires_at"] = None
        self.save()
        return 200, {"status": job["status"], "attempts": job["attempts"]}

    def get_job(self, job_id):
        if job_id not in self.jobs:
            return 404, {"error": "not_found"}
        return 200, self.jobs[job_id]

    def get_stats(self):
        stats = {"pending": 0, "leased": 0, "completed": 0, "dead_letter": 0}
        now = time.time()
        for j in self.jobs.values():
            st = j["status"]
            if st == "leased" and j["lease_expires_at"] and now >= j["lease_expires_at"]:
                # effectively pending
                stats["pending"] += 1
            elif st in stats:
                stats[st] += 1
        return 200, stats

    def handle(self, method, full_path, body=None):
        path = urlparse(full_path).path

        if method == "POST" and path == "/jobs":
            return self.enqueue(body or {})
        elif method == "POST" and path == "/jobs/lease":
            return self.lease(body or {})
        elif method == "POST" and path.startswith("/jobs/") and path.endswith("/ack"):
            job_id = path[len("/jobs/"):-len("/ack")]
            return self.ack(job_id, body or {})
        elif method == "POST" and path.startswith("/jobs/") and path.endswith("/fail"):
            job_id = path[len("/jobs/"):-len("/fail")]
            return self.fail(job_id, body or {})
        elif method == "GET" and path.startswith("/jobs/"):
            job_id = path[len("/jobs/"):]
            return self.get_job(job_id)
        elif method == "GET" and path == "/stats":
            return self.get_stats()
        return 404, {"error": "not_found"}


def run_server(engine, port):
    class RequestHandler(BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_POST(self):
            content_length = int(self.headers.get("Content-Length", 0))
            body_bytes = self.rfile.read(content_length) if content_length > 0 else b""
            body = None
            if body_bytes:
                try:
                    body = json.loads(body_bytes.decode("utf-8"))
                except Exception:
                    body = {}
            status, resp = engine.handle("POST", self.path, body)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

        def do_GET(self):
            status, resp = engine.handle("GET", self.path)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

    server = HTTPServer(("127.0.0.1", port), RequestHandler)
    server.serve_forever()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("subcommand", nargs="?", default=None)
    parser.add_argument("extra_arg", nargs="?", default=None)
    parser.add_argument("--port", type=int, default=None)
    parser.add_argument("--store", default="store.json")

    args, unknown = parser.parse_known_args()

    if args.subcommand == "replay":
        reqs_file = args.extra_arg
        if not reqs_file and unknown:
            reqs_file = unknown[0]
        if not reqs_file or not os.path.isfile(reqs_file):
            sys.exit(1)

        engine = Engine(args.store)
        with open(reqs_file, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                req = json.loads(line)
                method = req.get("method", "GET")
                path = req.get("path", "/")
                body = req.get("body")
                status, res_body = engine.handle(method, path, body)
                print(json.dumps({"status": status, "body": res_body}))
        sys.exit(0)

    port = args.port or int(os.environ.get("PORT", "0"))
    if not port:
        for i, a in enumerate(unknown):
            if a == "--port" and i + 1 < len(unknown):
                port = int(unknown[i+1])
    if not port:
        sys.exit(1)

    engine = Engine(args.store)
    run_server(engine, port)

if __name__ == "__main__":
    main()
