#!/usr/bin/env python3
import argparse
import json
import os
import sys
import time
from urllib.parse import urlparse
from http.server import HTTPServer, BaseHTTPRequestHandler

class Engine:
    def __init__(self, store_path):
        self.store_path = store_path
        self.topics = {}
        self.subscriptions = {}
        self.load()

    def load(self):
        if self.store_path and os.path.isfile(self.store_path):
            try:
                with open(self.store_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    self.topics = data.get("topics", {})
                    self.subscriptions = data.get("subscriptions", {})
            except Exception:
                self.topics = {}
                self.subscriptions = {}

    def save(self):
        if self.store_path:
            try:
                with open(self.store_path, "w", encoding="utf-8") as f:
                    json.dump({"topics": self.topics, "subscriptions": self.subscriptions}, f, indent=2)
            except Exception:
                pass

    def create_topic(self, body):
        if not isinstance(body, dict) or "topic" not in body or not body["topic"]:
            return 400, {"error": "invalid_payload"}
        topic = str(body["topic"])
        if topic in self.topics:
            return 409, {"error": "topic_exists"}

        max_events = int(body.get("max_events", 500))
        self.topics[topic] = {
            "max_events": max_events,
            "next_offset": 0,
            "events": []
        }
        self.save()
        return 201, {
            "topic": topic,
            "max_events": max_events,
            "head_offset": 0
        }

    def publish_event(self, topic, body):
        if topic not in self.topics:
            return 404, {"error": "not_found"}
        if not isinstance(body, dict) or "event_type" not in body:
            return 400, {"error": "invalid_payload"}

        t_data = self.topics[topic]
        offset = t_data["next_offset"]
        t_data["next_offset"] += 1
        now = time.time()

        event = {
            "offset": offset,
            "event_type": str(body["event_type"]),
            "payload": body.get("payload", {}),
            "timestamp": now
        }
        t_data["events"].append(event)
        max_events = t_data.get("max_events", 500)
        while len(t_data["events"]) > max_events:
            t_data["events"].pop(0)

        self.save()
        return 201, {
            "offset": offset,
            "timestamp": now
        }

    def consume(self, group, body):
        if not isinstance(body, dict) or "topic" not in body:
            return 400, {"error": "invalid_payload"}
        topic = body["topic"]
        if topic not in self.topics:
            return 404, {"error": "not_found"}

        limit = int(body.get("limit", 10))
        auto_commit = bool(body.get("auto_commit", True))

        t_data = self.topics[topic]
        events = t_data["events"]

        if group not in self.subscriptions:
            self.subscriptions[group] = {}

        if topic not in self.subscriptions[group]:
            cursor = events[0]["offset"] if events else 0
            self.subscriptions[group][topic] = cursor
        else:
            cursor = self.subscriptions[group][topic]

        # Fetch up to limit events where offset >= cursor
        returned = []
        for e in events:
            if e["offset"] >= cursor:
                returned.append(e)
                if len(returned) >= limit:
                    break

        next_cursor = cursor
        if returned:
            next_cursor = returned[-1]["offset"] + 1
            if auto_commit:
                self.subscriptions[group][topic] = next_cursor
                self.save()

        return 200, {
            "topic": topic,
            "group": group,
            "events": returned,
            "next_offset": next_cursor
        }

    def seek(self, group, body):
        if not isinstance(body, dict) or "topic" not in body or "offset" not in body:
            return 400, {"error": "invalid_payload"}
        topic = body["topic"]
        if topic not in self.topics:
            return 404, {"error": "not_found"}

        offset = int(body["offset"])
        if group not in self.subscriptions:
            self.subscriptions[group] = {}
        self.subscriptions[group][topic] = offset
        self.save()

        return 200, {
            "group": group,
            "topic": topic,
            "committed_offset": offset
        }

    def get_topic(self, topic):
        if topic not in self.topics:
            return 404, {"error": "not_found"}
        t_data = self.topics[topic]
        events = t_data["events"]
        earliest = events[0]["offset"] if events else None
        return 200, {
            "topic": topic,
            "max_events": t_data.get("max_events", 500),
            "event_count": len(events),
            "earliest_offset": earliest,
            "next_offset": t_data.get("next_offset", 0)
        }

    def handle(self, method, full_path, body=None):
        path = urlparse(full_path).path

        if method == "POST" and path == "/topics":
            return self.create_topic(body or {})
        elif method == "POST" and path.startswith("/topics/") and path.endswith("/publish"):
            topic = path[len("/topics/"):-len("/publish")]
            return self.publish_event(topic, body or {})
        elif method == "POST" and path.startswith("/subscriptions/") and path.endswith("/consume"):
            group = path[len("/subscriptions/"):-len("/consume")]
            return self.consume(group, body or {})
        elif method == "POST" and path.startswith("/subscriptions/") and path.endswith("/seek"):
            group = path[len("/subscriptions/"):-len("/seek")]
            return self.seek(group, body or {})
        elif method == "GET" and path.startswith("/topics/"):
            topic = path[len("/topics/"):]
            return self.get_topic(topic)
        return 404, {"error": "not_found"}


def run_server(engine, port):
    class RequestHandler(BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_POST(self):
            content_length = int(self.headers.get("Content-Length", 0))
            body_bytes = self.rfile.read(content_length) if content_length > 0 else b""
            body = None
            if body_bytes:
                try:
                    body = json.loads(body_bytes.decode("utf-8"))
                except Exception:
                    body = {}
            status, resp = engine.handle("POST", self.path, body)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

        def do_GET(self):
            status, resp = engine.handle("GET", self.path)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

    server = HTTPServer(("127.0.0.1", port), RequestHandler)
    server.serve_forever()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("subcommand", nargs="?", default=None)
    parser.add_argument("extra_arg", nargs="?", default=None)
    parser.add_argument("--port", type=int, default=None)
    parser.add_argument("--store", default="store.json")

    args, unknown = parser.parse_known_args()

    if args.subcommand == "replay":
        reqs_file = args.extra_arg
        if not reqs_file and unknown:
            reqs_file = unknown[0]
        if not reqs_file or not os.path.isfile(reqs_file):
            sys.exit(1)

        engine = Engine(args.store)
        with open(reqs_file, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                req = json.loads(line)
                method = req.get("method", "GET")
                path = req.get("path", "/")
                body = req.get("body")
                status, res_body = engine.handle(method, path, body)
                print(json.dumps({"status": status, "body": res_body}))
        sys.exit(0)

    port = args.port or int(os.environ.get("PORT", "0"))
    if not port:
        for i, a in enumerate(unknown):
            if a == "--port" and i + 1 < len(unknown):
                port = int(unknown[i+1])
    if not port:
        sys.exit(1)

    engine = Engine(args.store)
    run_server(engine, port)

if __name__ == "__main__":
    main()
