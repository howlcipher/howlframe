#!/usr/bin/env python3
import argparse
import json
import os
import sys
from http.server import HTTPServer, BaseHTTPRequestHandler

TIER_LEVELS = {
    "basic": 1,
    "pro": 2,
    "enterprise": 3
}

class Engine:
    def __init__(self, store_path):
        self.store_path = store_path
        self.flags = {}
        self.load()

    def load(self):
        if self.store_path and os.path.isfile(self.store_path):
            try:
                with open(self.store_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    self.flags = data.get("flags", {})
            except Exception:
                self.flags = {}

    def save(self):
        if self.store_path:
            try:
                with open(self.store_path, "w", encoding="utf-8") as f:
                    json.dump({"flags": self.flags}, f, indent=2)
            except Exception:
                pass

    def create_flag(self, body):
        if not isinstance(body, dict):
            return 400, {"error": "invalid_payload"}
        key = body.get("key")
        enabled = body.get("enabled", True)
        min_tier = body.get("min_tier")
        allowed_roles = body.get("allowed_roles")
        user_overrides = body.get("user_overrides", [])

        if not key or not isinstance(key, str):
            return 400, {"error": "invalid_payload"}
        if min_tier not in TIER_LEVELS:
            return 400, {"error": "invalid_payload"}
        if not isinstance(allowed_roles, list):
            return 400, {"error": "invalid_payload"}
        if not isinstance(user_overrides, list):
            user_overrides = []

        flag_obj = {
            "key": key,
            "enabled": bool(enabled),
            "min_tier": min_tier,
            "allowed_roles": allowed_roles,
            "user_overrides": user_overrides
        }
        self.flags[key] = flag_obj
        self.save()
        return 201, flag_obj

    def evaluate(self, body):
        if not isinstance(body, dict):
            return 400, {"error": "invalid_payload"}
        key = body.get("key")
        user_id = body.get("user_id", "")
        tier = body.get("tier", "basic")
        role = body.get("role", "")

        if key not in self.flags:
            return 404, {"error": "flag_not_found"}

        flag = self.flags[key]
        if not flag.get("enabled", True):
            return 200, {"granted": False, "reason": "flag_disabled"}

        overrides = flag.get("user_overrides", [])
        if user_id in overrides:
            return 200, {"granted": True, "reason": "user_override"}

        sub_level = TIER_LEVELS.get(tier, 0)
        req_level = TIER_LEVELS.get(flag.get("min_tier"), 99)
        if sub_level < req_level:
            return 200, {"granted": False, "reason": "insufficient_tier"}

        allowed_roles = flag.get("allowed_roles", [])
        if role not in allowed_roles:
            return 200, {"granted": False, "reason": "role_unauthorized"}

        return 200, {"granted": True, "reason": "entitled"}

    def get_flag(self, key):
        if key not in self.flags:
            return 404, {"error": "flag_not_found"}
        return 200, self.flags[key]

    def delete_flag(self, key):
        if key not in self.flags:
            return 404, {"error": "flag_not_found"}
        del self.flags[key]
        self.save()
        return 204, None

    def list_flags(self):
        sorted_keys = sorted(self.flags.keys())
        return 200, {"flags": [self.flags[k] for k in sorted_keys]}

    def handle(self, method, path, body=None):
        if method == "POST" and path == "/flags":
            return self.create_flag(body or {})
        elif method == "POST" and path == "/evaluate":
            return self.evaluate(body or {})
        elif method == "GET" and path == "/flags":
            return self.list_flags()
        elif method == "GET" and path.startswith("/flags/"):
            key = path[len("/flags/"):]
            return self.get_flag(key)
        elif method == "DELETE" and path.startswith("/flags/"):
            key = path[len("/flags/"):]
            return self.delete_flag(key)
        return 404, {"error": "not_found"}


def run_server(engine, port):
    class RequestHandler(BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_POST(self):
            content_length = int(self.headers.get("Content-Length", 0))
            body_bytes = self.rfile.read(content_length) if content_length > 0 else b""
            body = None
            if body_bytes:
                try:
                    body = json.loads(body_bytes.decode("utf-8"))
                except Exception:
                    body = {}
            status, resp = engine.handle("POST", self.path, body)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

        def do_GET(self):
            status, resp = engine.handle("GET", self.path)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

        def do_DELETE(self):
            status, resp = engine.handle("DELETE", self.path)
            self.send_response(status)
            self.send_header("Content-Length", "0")
            self.end_headers()

    server = HTTPServer(("127.0.0.1", port), RequestHandler)
    server.serve_forever()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("subcommand", nargs="?", default=None)
    parser.add_argument("extra_arg", nargs="?", default=None)
    parser.add_argument("--port", type=int, default=None)
    parser.add_argument("--store", default="store.json")

    args, unknown = parser.parse_known_args()

    if args.subcommand == "replay":
        reqs_file = args.extra_arg
        if not reqs_file and unknown:
            reqs_file = unknown[0]
        if not reqs_file or not os.path.isfile(reqs_file):
            sys.exit(1)

        engine = Engine(args.store)
        with open(reqs_file, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                req = json.loads(line)
                method = req.get("method", "GET")
                path = req.get("path", "/")
                body = req.get("body")
                status, res_body = engine.handle(method, path, body)
                print(json.dumps({"status": status, "body": res_body}))
        sys.exit(0)

    port = args.port or int(os.environ.get("PORT", "0"))
    if not port:
        for i, a in enumerate(unknown):
            if a == "--port" and i + 1 < len(unknown):
                port = int(unknown[i+1])
    if not port:
        sys.exit(1)

    engine = Engine(args.store)
    run_server(engine, port)

if __name__ == "__main__":
    main()
