#!/usr/bin/env python3
import argparse
import json
import os
import sys
import time
from urllib.parse import urlparse
from http.server import HTTPServer, BaseHTTPRequestHandler

class Engine:
    def __init__(self, store_path):
        self.store_path = store_path
        self.entries = {}
        self.total_purged = 0
        self.load()

    def load(self):
        if self.store_path and os.path.isfile(self.store_path):
            try:
                with open(self.store_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    self.entries = data.get("entries", {})
                    self.total_purged = data.get("total_purged", 0)
            except Exception:
                self.entries = {}
                self.total_purged = 0

    def save(self):
        if self.store_path:
            try:
                with open(self.store_path, "w", encoding="utf-8") as f:
                    json.dump({"entries": self.entries, "total_purged": self.total_purged}, f, indent=2)
            except Exception:
                pass

    def is_active(self, entry):
        if not entry:
            return False
        exp = entry.get("expires_at")
        if exp is not None and time.time() >= exp:
            return False
        return True

    def post_cache(self, body):
        if not isinstance(body, dict):
            return 400, {"error": "invalid_payload"}
        key = body.get("key")
        val = body.get("value")
        tags = body.get("tags")
        ttl = body.get("ttl_seconds")

        if not key or not isinstance(key, str) or val is None or not isinstance(tags, list):
            return 400, {"error": "invalid_payload"}

        now = time.time()
        expires_at = (now + float(ttl)) if ttl is not None and float(ttl) > 0 else None

        entry = {
            "key": key,
            "value": val,
            "tags": sorted(list(set(str(t) for t in tags))),
            "expires_at": expires_at
        }
        self.entries[key] = entry
        self.save()
        return 201, entry

    def get_cache(self, key):
        entry = self.entries.get(key)
        if not self.is_active(entry):
            return 404, {"error": "not_found"}
        return 200, entry

    def purge_tags(self, body):
        if not isinstance(body, dict):
            return 400, {"error": "invalid_payload"}
        tags = body.get("tags")
        if not isinstance(tags, list) or len(tags) == 0:
            return 400, {"error": "invalid_payload"}

        purge_set = set(str(t) for t in tags)
        to_delete = []

        for k, e in self.entries.items():
            if self.is_active(e):
                entry_tags = set(e.get("tags", []))
                if entry_tags.intersection(purge_set):
                    to_delete.append(k)

        for k in to_delete:
            del self.entries[k]

        self.total_purged += len(to_delete)
        self.save()

        return 200, {
            "purged_count": len(to_delete),
            "purged_keys": sorted(to_delete)
        }

    def delete_cache(self, key):
        entry = self.entries.get(key)
        if not self.is_active(entry):
            return 404, {"error": "not_found"}
        del self.entries[key]
        self.total_purged += 1
        self.save()
        return 204, None

    def get_tags(self, tag):
        matching = []
        for k, e in self.entries.items():
            if self.is_active(e) and tag in e.get("tags", []):
                matching.append(k)
        return 200, {
            "tag": tag,
            "keys": sorted(matching)
        }

    def get_stats(self):
        active_entries = 0
        all_tags = set()
        for e in self.entries.values():
            if self.is_active(e):
                active_entries += 1
                for t in e.get("tags", []):
                    all_tags.add(t)

        return 200, {
            "active_entries": active_entries,
            "total_purged": self.total_purged,
            "active_tags": len(all_tags)
        }

    def handle(self, method, full_path, body=None):
        path = urlparse(full_path).path

        if method == "POST" and path == "/cache":
            return self.post_cache(body or {})
        elif method == "GET" and path.startswith("/cache/"):
            key = path[len("/cache/"):]
            return self.get_cache(key)
        elif method == "DELETE" and path.startswith("/cache/"):
            key = path[len("/cache/"):]
            return self.delete_cache(key)
        elif method == "POST" and path == "/purge":
            return self.purge_tags(body or {})
        elif method == "GET" and path.startswith("/tags/"):
            tag = path[len("/tags/"):]
            return self.get_tags(tag)
        elif method == "GET" and path == "/stats":
            return self.get_stats()
        return 404, {"error": "not_found"}


def run_server(engine, port):
    class RequestHandler(BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_POST(self):
            content_length = int(self.headers.get("Content-Length", 0))
            body_bytes = self.rfile.read(content_length) if content_length > 0 else b""
            body = None
            if body_bytes:
                try:
                    body = json.loads(body_bytes.decode("utf-8"))
                except Exception:
                    body = {}
            status, resp = engine.handle("POST", self.path, body)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

        def do_GET(self):
            status, resp = engine.handle("GET", self.path)
            self.send_response(status)
            if resp is not None:
                resp_bytes = json.dumps(resp).encode("utf-8")
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(resp_bytes)))
                self.end_headers()
                self.wfile.write(resp_bytes)
            else:
                self.send_header("Content-Length", "0")
                self.end_headers()

        def do_DELETE(self):
            status, resp = engine.handle("DELETE", self.path)
            self.send_response(status)
            self.send_header("Content-Length", "0")
            self.end_headers()

    server = HTTPServer(("127.0.0.1", port), RequestHandler)
    server.serve_forever()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("subcommand", nargs="?", default=None)
    parser.add_argument("extra_arg", nargs="?", default=None)
    parser.add_argument("--port", type=int, default=None)
    parser.add_argument("--store", default="store.json")

    args, unknown = parser.parse_known_args()

    if args.subcommand == "replay":
        reqs_file = args.extra_arg
        if not reqs_file and unknown:
            reqs_file = unknown[0]
        if not reqs_file or not os.path.isfile(reqs_file):
            sys.exit(1)

        engine = Engine(args.store)
        with open(reqs_file, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                req = json.loads(line)
                method = req.get("method", "GET")
                path = req.get("path", "/")
                body = req.get("body")
                status, res_body = engine.handle(method, path, body)
                print(json.dumps({"status": status, "body": res_body}))
        sys.exit(0)

    port = args.port or int(os.environ.get("PORT", "0"))
    if not port:
        for i, a in enumerate(unknown):
            if a == "--port" and i + 1 < len(unknown):
                port = int(unknown[i+1])
    if not port:
        sys.exit(1)

    engine = Engine(args.store)
    run_server(engine, port)

if __name__ == "__main__":
    main()
