#!/usr/bin/env python3
import argparse
import json
import os
import sys

def main():
    if len(sys.argv) < 2 or sys.argv[1] != "verify-sbom":
        sys.exit(1)

    parser = argparse.ArgumentParser()
    parser.add_argument("subcommand")
    parser.add_argument("--sbom", required=True)
    parser.add_argument("--policy", required=True)
    parser.add_argument("--report", required=True)

    try:
        args = parser.parse_args()
    except SystemExit:
        sys.exit(1)

    if not os.path.isfile(args.sbom) or not os.path.isfile(args.policy):
        sys.exit(1)

    try:
        with open(args.policy, "r", encoding="utf-8") as f:
            policy = json.load(f)
        with open(args.sbom, "r", encoding="utf-8") as f:
            sbom = json.load(f)
    except Exception:
        sys.exit(1)

    if not isinstance(policy, dict) or not isinstance(sbom, dict):
        sys.exit(1)

    allowed_licenses = set(policy.get("allowed_licenses", []))
    tier_capabilities = policy.get("tier_capabilities", {})
    package_tiers = policy.get("package_tiers", {})
    default_tier = policy.get("default_tier", "tier_3_untrusted")

    packages = sbom.get("packages", [])
    if not isinstance(packages, list):
        sys.exit(1)

    violations = []
    effective_caps_map = {}

    for pkg in packages:
        if not isinstance(pkg, dict):
            continue
        pname = pkg.get("name", "unknown")
        plic = pkg.get("license", "")
        req_caps = pkg.get("requested_capabilities", [])
        if not isinstance(req_caps, list):
            req_caps = []

        # Determine tier
        tier = package_tiers.get(pname, default_tier)
        allowed_caps = set(tier_capabilities.get(tier, []))

        # Check license
        if plic not in allowed_licenses:
            violations.append({
                "package": pname,
                "violation_type": "disallowed_license",
                "detail": f"License '{plic}' is not permitted"
            })

        # Check capabilities
        granted = []
        for cap in req_caps:
            if cap not in allowed_caps:
                violations.append({
                    "package": pname,
                    "violation_type": "unauthorized_capability",
                    "detail": f"Capability '{cap}' not permitted for tier '{tier}'"
                })
            else:
                granted.append(cap)

        effective_caps_map[pname] = sorted(granted)

    violations.sort(key=lambda v: (v["package"], v["violation_type"], v["detail"]))

    sorted_eff_caps = {}
    for k in sorted(effective_caps_map.keys()):
        sorted_eff_caps[k] = effective_caps_map[k]

    report = {
        "compliant": len(violations) == 0,
        "total_packages": len(packages),
        "violations_count": len(violations),
        "violations": violations,
        "effective_capabilities": sorted_eff_caps
    }

    try:
        with open(args.report, "w", encoding="utf-8") as f:
            json.dump(report, f, indent=2)
    except Exception:
        sys.exit(1)

    if len(violations) > 0:
        sys.exit(2)
    sys.exit(0)

if __name__ == "__main__":
    main()
