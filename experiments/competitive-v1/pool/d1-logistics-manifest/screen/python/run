#!/usr/bin/env python3
import argparse
import csv
import json
import os
import sys

def main():
    if len(sys.argv) < 2 or sys.argv[1] != "pack":
        sys.exit(1)

    parser = argparse.ArgumentParser()
    parser.add_argument("subcommand")
    parser.add_argument("--packages", required=True)
    parser.add_argument("--rules", required=True)
    parser.add_argument("--output", required=True)

    try:
        args = parser.parse_args()
    except SystemExit:
        sys.exit(1)

    if not os.path.isfile(args.packages) or not os.path.isfile(args.rules):
        sys.exit(2)

    try:
        with open(args.rules, "r", encoding="utf-8") as f:
            rules = json.load(f)
    except Exception:
        sys.exit(1)

    max_weight = float(rules.get("max_container_weight_kg", 0.0))
    max_hazard = int(rules.get("max_hazard_items_per_container", 0))
    allowed_destinations = set(rules.get("allowed_destinations", []))

    valid_packages = []
    rejected_packages = []

    try:
        with open(args.packages, "r", encoding="utf-8") as f:
            reader = csv.reader(f)
            header = next(reader, None)
            if not header:
                sys.exit(1)
            
            # Map column indices
            expected = ["package_id", "destination", "weight_kg", "is_hazardous", "priority"]
            header = [h.strip() for h in header]
            if header != expected:
                sys.exit(1)

            for row in reader:
                if not row or len(row) != 5:
                    continue
                pkg_id, dest, weight_str, haz_str, prio_str = [c.strip() for c in row]

                # Validation
                if not pkg_id:
                    rejected_packages.append({"package_id": pkg_id or "UNKNOWN", "reason": "invalid_fields"})
                    continue

                # Check numbers and booleans
                try:
                    weight = float(weight_str)
                    prio = int(prio_str)
                except ValueError:
                    rejected_packages.append({"package_id": pkg_id, "reason": "invalid_fields"})
                    continue

                haz_lower = haz_str.lower()
                if haz_lower not in ("true", "false"):
                    rejected_packages.append({"package_id": pkg_id, "reason": "invalid_fields"})
                    continue
                is_haz = (haz_lower == "true")

                if prio < 1 or prio > 5:
                    rejected_packages.append({"package_id": pkg_id, "reason": "invalid_fields"})
                    continue

                # Invalid destination
                if dest not in allowed_destinations:
                    rejected_packages.append({"package_id": pkg_id, "reason": "invalid_destination"})
                    continue

                # Overweight
                if weight <= 0 or weight > max_weight:
                    rejected_packages.append({"package_id": pkg_id, "reason": "overweight"})
                    continue

                valid_packages.append({
                    "package_id": pkg_id,
                    "destination": dest,
                    "weight_kg": weight,
                    "is_hazardous": is_haz,
                    "priority": prio
                })

    except Exception:
        sys.exit(2)

    # Sort valid packages: priority ASC, weight_kg DESC, package_id ASC
    valid_packages.sort(key=lambda p: (p["priority"], -p["weight_kg"], p["package_id"]))

    containers = []
    # Packing
    for p in valid_packages:
        assigned = False
        for c in containers:
            if c["destination"] != p["destination"]:
                continue
            if c["total_weight_kg"] + p["weight_kg"] > max_weight:
                continue
            if p["is_hazardous"] and c["hazard_count"] + 1 > max_hazard:
                continue
            
            # Place in this container
            c["package_ids"].append(p["package_id"])
            c["total_weight_kg"] = round(c["total_weight_kg"] + p["weight_kg"], 2)
            if p["is_hazardous"]:
                c["hazard_count"] += 1
            assigned = True
            break

        if not assigned:
            c_id = f"CONT-{len(containers) + 1}"
            containers.append({
                "container_id": c_id,
                "destination": p["destination"],
                "total_weight_kg": round(p["weight_kg"], 2),
                "hazard_count": 1 if p["is_hazardous"] else 0,
                "package_ids": [p["package_id"]]
            })

    rejected_packages.sort(key=lambda r: r["package_id"])

    manifest = {
        "total_containers": len(containers),
        "total_packed_packages": sum(len(c["package_ids"]) for c in containers),
        "containers": containers,
        "rejected_packages": rejected_packages
    }

    try:
        with open(args.output, "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2)
    except Exception:
        sys.exit(1)

    sys.exit(0)

if __name__ == "__main__":
    main()
