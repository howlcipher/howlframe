(cli_app
  (defun round_2 (x)
    (type_hint x "float")
    (type_hint return "float")
    (return (/ (to_float (to_int (+ (* x 100.0) 0.5))) 100.0))
  )

  (defun round_4 (x)
    (type_hint x "float")
    (type_hint return "float")
    (return (/ (to_float (to_int (+ (* x 10000.0) 0.5))) 10000.0))
  )

  (defun validate_whole_number (v min_val max_val)
    (type_hint v "any")
    (type_hint min_val "int")
    (type_hint max_val "int")
    (type_hint return "int")
    (try_let (iv (to_int v))
      (catch err (return -1))
      (if (and (= v iv) (and (>= iv min_val) (<= iv max_val)))
        (return iv)
        (return -1)
      )
    )
  )

  (defun is_valid_string (s)
    (type_hint s "any")
    (type_hint return "int")
    (try_let (slen (str_len s))
      (catch err (return 0))
      (if (> slen 0)
        (return 1)
        (return 0)
      )
    )
  )

  (defun is_valid_method (m)
    (type_hint m "any")
    (type_hint return "int")
    (try_let (mlen (str_len m))
      (catch err (return 0))
      (if (or (= m "GET")
          (or (= m "POST")
          (or (= m "PUT")
          (or (= m "DELETE")
          (or (= m "PATCH")
          (or (= m "HEAD")
              (= m "OPTIONS")))))))
        (return 1)
        (return 0)
      )
    )
  )

  (defun is_valid_path (p)
    (type_hint p "any")
    (type_hint return "int")
    (try_let (plen (str_len p))
      (catch err (return 0))
      (if (and (> plen 0) (starts_with p "/"))
        (return 1)
        (return 0)
      )
    )
  )

  (let (args (cli_args))
    (let (num_args (list_len args))
      (let (arg_i 0)
        (let (input_path "-")
          (let (output_path "-")
            (let (sla_latency_ms 500)
              (let (error_rate_threshold 0.05)
                (let (window_seconds 300)
                  (do
                    ;; Parse CLI options
                    (while (< arg_i num_args)
                      (let (arg (list_get args arg_i))
                        (if (starts_with arg "--input=")
                          (do
                            (set input_path (str_slice arg 8 (str_len arg)))
                            (set arg_i (+ arg_i 1))
                          )
                          (if (= arg "--input")
                            (if (>= (+ arg_i 1) num_args)
                              (do (stderr "Missing value for --input\n") (exit 1))
                              (do
                                (set input_path (list_get args (+ arg_i 1)))
                                (set arg_i (+ arg_i 2))
                              )
                            )
                            (if (starts_with arg "--output=")
                              (do
                                (set output_path (str_slice arg 9 (str_len arg)))
                                (set arg_i (+ arg_i 1))
                              )
                              (if (= arg "--output")
                                (if (>= (+ arg_i 1) num_args)
                                  (do (stderr "Missing value for --output\n") (exit 1))
                                  (do
                                    (set output_path (list_get args (+ arg_i 1)))
                                    (set arg_i (+ arg_i 2))
                                  )
                                )
                                (if (starts_with arg "--sla-latency-ms=")
                                  (let (val_str (str_slice arg 17 (str_len arg)))
                                    (try_let (parsed_lat (to_int val_str))
                                      (catch err (do (stderr "Invalid sla latency\n") (exit 1)))
                                      (if (< parsed_lat 0)
                                        (do (stderr "Negative sla latency\n") (exit 1))
                                        (do
                                          (set sla_latency_ms parsed_lat)
                                          (set arg_i (+ arg_i 1))
                                        )
                                      )
                                    )
                                  )
                                  (if (= arg "--sla-latency-ms")
                                    (if (>= (+ arg_i 1) num_args)
                                      (do (stderr "Missing value for --sla-latency-ms\n") (exit 1))
                                      (let (val_str (list_get args (+ arg_i 1)))
                                        (try_let (parsed_lat (to_int val_str))
                                          (catch err (do (stderr "Invalid sla latency\n") (exit 1)))
                                          (if (< parsed_lat 0)
                                            (do (stderr "Negative sla latency\n") (exit 1))
                                            (do
                                              (set sla_latency_ms parsed_lat)
                                              (set arg_i (+ arg_i 2))
                                            )
                                          )
                                        )
                                      )
                                    )
                                    (if (starts_with arg "--error-rate-threshold=")
                                      (let (val_str (str_slice arg 23 (str_len arg)))
                                        (try_let (parsed_rate (to_float val_str))
                                          (catch err (do (stderr "Invalid error rate\n") (exit 1)))
                                          (if (or (!= parsed_rate parsed_rate) (or (< parsed_rate 0.0) (> parsed_rate 1.0)))
                                            (do (stderr "Error rate out of bounds\n") (exit 1))
                                            (do
                                              (set error_rate_threshold parsed_rate)
                                              (set arg_i (+ arg_i 1))
                                            )
                                          )
                                        )
                                      )
                                      (if (= arg "--error-rate-threshold")
                                        (if (>= (+ arg_i 1) num_args)
                                          (do (stderr "Missing value for --error-rate-threshold\n") (exit 1))
                                          (let (val_str (list_get args (+ arg_i 1)))
                                            (try_let (parsed_rate (to_float val_str))
                                              (catch err (do (stderr "Invalid error rate\n") (exit 1)))
                                              (if (or (!= parsed_rate parsed_rate) (or (< parsed_rate 0.0) (> parsed_rate 1.0)))
                                                (do (stderr "Error rate out of bounds\n") (exit 1))
                                                (do
                                                  (set error_rate_threshold parsed_rate)
                                                  (set arg_i (+ arg_i 2))
                                                )
                                              )
                                            )
                                          )
                                        )
                                        (if (starts_with arg "--window-seconds=")
                                          (let (val_str (str_slice arg 17 (str_len arg)))
                                            (try_let (parsed_win (to_int val_str))
                                              (catch err (do (stderr "Invalid window seconds\n") (exit 1)))
                                              (if (<= parsed_win 0)
                                                (do (stderr "Window seconds must be positive\n") (exit 1))
                                                (do
                                                  (set window_seconds parsed_win)
                                                  (set arg_i (+ arg_i 1))
                                                )
                                              )
                                            )
                                          )
                                          (if (= arg "--window-seconds")
                                            (if (>= (+ arg_i 1) num_args)
                                              (do (stderr "Missing value for --window-seconds\n") (exit 1))
                                              (let (val_str (list_get args (+ arg_i 1)))
                                                (try_let (parsed_win (to_int val_str))
                                                  (catch err (do (stderr "Invalid window seconds\n") (exit 1)))
                                                  (if (<= parsed_win 0)
                                                    (do (stderr "Window seconds must be positive\n") (exit 1))
                                                    (do
                                                      (set window_seconds parsed_win)
                                                      (set arg_i (+ arg_i 2))
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                            ;; Unknown option
                                            (do
                                              (stderr (str "Unknown option: " arg "\n"))
                                              (exit 1)
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )

                    ;; Read Input
                    (let (raw_content "")
                      (do
                        (if (= input_path "-")
                          (set raw_content (read_stdin))
                          (try_let (file_data (read_file input_path))
                            (catch err
                              (do
                                (stderr (str "Error reading input file: " input_path "\n"))
                                (exit 2)
                              )
                            )
                            (set raw_content (bytes_to_string file_data))
                          )
                        )

                        ;; Aggregation State
                        (let (total_records 0)
                          (let (valid_records 0)
                            (let (invalid_records 0)
                              (let (total_bytes_sent 0)
                                (let (has_timestamp 0)
                                  (let (earliest_timestamp 0)
                                    (let (latest_timestamp 0)
                                      (let (services_map (dict))
                                        (let (clients_map (dict))
                                          (let (windows_map (dict))
                                            (do
                                              ;; Split into lines
                                              (let (lines (str_split raw_content "\n"))
                                                (for raw_line lines
                                                  (let (line (str_trim raw_line))
                                                    (if (!= line "")
                                                      (let (is_valid 0)
                                                        (do
                                                          (try_let (parsed (parse_json Any line))
                                                            (catch parse_err (set is_valid 0))
                                                            (try_let (keys (map_keys parsed))
                                                              (catch keys_err (set is_valid 0))
                                                              (let (ts (call validate_whole_number (map_get parsed "timestamp") 0 9007199254740991))
                                                                (if (>= ts 0)
                                                                  (let (st (call validate_whole_number (map_get parsed "status") 100 599))
                                                                    (if (>= st 0)
                                                                      (let (lat (call validate_whole_number (map_get parsed "latency_ms") 0 9007199254740991))
                                                                        (if (>= lat 0)
                                                                          (let (bs (call validate_whole_number (map_get parsed "bytes_sent") 0 9007199254740991))
                                                                            (if (>= bs 0)
                                                                              (if (= (call is_valid_string (map_get parsed "service")) 1)
                                                                                (if (= (call is_valid_string (map_get parsed "client_id")) 1)
                                                                                  (if (= (call is_valid_method (map_get parsed "method")) 1)
                                                                                    (if (= (call is_valid_path (map_get parsed "path")) 1)
                                                                                      (do
                                                                                        (set is_valid 1)
                                                                                        ;; Process valid record
                                                                                        (set valid_records (+ valid_records 1))
                                                                                        (set total_bytes_sent (+ total_bytes_sent bs))
                                                                                        (if (= has_timestamp 0)
                                                                                          (do
                                                                                            (set earliest_timestamp ts)
                                                                                            (set latest_timestamp ts)
                                                                                            (set has_timestamp 1)
                                                                                          )
                                                                                          (do
                                                                                            (if (< ts earliest_timestamp) (set earliest_timestamp ts))
                                                                                            (if (> ts latest_timestamp) (set latest_timestamp ts))
                                                                                          )
                                                                                        )

                                                                                        ;; Update service metrics
                                                                                        (let (svc (map_get parsed "service"))
                                                                                          (let (svc_entry (map_get services_map svc))
                                                                                            (if (is_nil svc_entry)
                                                                                              (let (succ (if (and (>= st 200) (< st 400)) 1 0))
                                                                                                (let (cl_err (if (and (>= st 400) (< st 500)) 1 0))
                                                                                                  (let (sv_err (if (and (>= st 500) (<= st 599)) 1 0))
                                                                                                    (let (new_svc (dict
                                                                                                      ("service" svc)
                                                                                                      ("total_requests" 1)
                                                                                                      ("successful_requests" succ)
                                                                                                      ("client_error_requests" cl_err)
                                                                                                      ("server_error_requests" sv_err)
                                                                                                      ("min_latency_ms" lat)
                                                                                                      ("max_latency_ms" lat)
                                                                                                      ("total_latency_ms" lat)
                                                                                                      ("total_bytes_sent" bs)
                                                                                                    ))
                                                                                                      (map_set services_map svc new_svc)
                                                                                                    )
                                                                                                  )
                                                                                                )
                                                                                              )
                                                                                              (do
                                                                                                (map_set svc_entry "total_requests" (+ (map_get svc_entry "total_requests") 1))
                                                                                                (if (and (>= st 200) (< st 400))
                                                                                                  (map_set svc_entry "successful_requests" (+ (map_get svc_entry "successful_requests") 1))
                                                                                                )
                                                                                                (if (and (>= st 400) (< st 500))
                                                                                                  (map_set svc_entry "client_error_requests" (+ (map_get svc_entry "client_error_requests") 1))
                                                                                                )
                                                                                                (if (and (>= st 500) (<= st 599))
                                                                                                  (map_set svc_entry "server_error_requests" (+ (map_get svc_entry "server_error_requests") 1))
                                                                                                )
                                                                                                (if (< lat (map_get svc_entry "min_latency_ms"))
                                                                                                  (map_set svc_entry "min_latency_ms" lat)
                                                                                                )
                                                                                                (if (> lat (map_get svc_entry "max_latency_ms"))
                                                                                                  (map_set svc_entry "max_latency_ms" lat)
                                                                                                )
                                                                                                (map_set svc_entry "total_latency_ms" (+ (map_get svc_entry "total_latency_ms") lat))
                                                                                                (map_set svc_entry "total_bytes_sent" (+ (map_get svc_entry "total_bytes_sent") bs))
                                                                                              )
                                                                                            )
                                                                                          )
                                                                                        )

                                                                                        ;; Update client metrics
                                                                                        (let (cid (map_get parsed "client_id"))
                                                                                          (let (cl_entry (map_get clients_map cid))
                                                                                            (if (is_nil cl_entry)
                                                                                              (let (err_c (if (>= st 400) 1 0))
                                                                                                (let (new_cl (dict
                                                                                                  ("client_id" cid)
                                                                                                  ("request_count" 1)
                                                                                                  ("total_bytes" bs)
                                                                                                  ("error_count" err_c)
                                                                                                ))
                                                                                                  (map_set clients_map cid new_cl)
                                                                                                )
                                                                                              )
                                                                                              (do
                                                                                                (map_set cl_entry "request_count" (+ (map_get cl_entry "request_count") 1))
                                                                                                (map_set cl_entry "total_bytes" (+ (map_get cl_entry "total_bytes") bs))
                                                                                                (if (>= st 400)
                                                                                                  (map_set cl_entry "error_count" (+ (map_get cl_entry "error_count") 1))
                                                                                                )
                                                                                              )
                                                                                            )
                                                                                          )
                                                                                        )

                                                                                        ;; Update window metrics
                                                                                        (let (win_start (- ts (% ts window_seconds)))
                                                                                          (let (win_end (+ win_start window_seconds))
                                                                                            (let (win_key (pad_left (to_string win_start) 16 "0"))
                                                                                              (let (w_entry (map_get windows_map win_key))
                                                                                                (if (is_nil w_entry)
                                                                                                  (let (err_c (if (>= st 400) 1 0))
                                                                                                    (let (new_w (dict
                                                                                                      ("window_start" win_start)
                                                                                                      ("window_end" win_end)
                                                                                                      ("total_requests" 1)
                                                                                                      ("error_requests" err_c)
                                                                                                      ("total_latency_ms" lat)
                                                                                                    ))
                                                                                                      (map_set windows_map win_key new_w)
                                                                                                    )
                                                                                                  )
                                                                                                  (do
                                                                                                    (map_set w_entry "total_requests" (+ (map_get w_entry "total_requests") 1))
                                                                                                    (if (>= st 400)
                                                                                                      (map_set w_entry "error_requests" (+ (map_get w_entry "error_requests") 1))
                                                                                                    )
                                                                                                    (map_set w_entry "total_latency_ms" (+ (map_get w_entry "total_latency_ms") lat))
                                                                                                  )
                                                                                                )
                                                                                              )
                                                                                            )
                                                                                          )
                                                                                        )
                                                                                      )
                                                                                    )
                                                                                  )
                                                                                )
                                                                              )
                                                                            )
                                                                          )
                                                                        )
                                                                      )
                                                                    )
                                                                  )
                                                                )
                                                              )
                                                            )
                                                          )
                                                          (if (= is_valid 0)
                                                            (set invalid_records (+ invalid_records 1))
                                                          )
                                                          (set total_records (+ total_records 1))
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )

                                              ;; Generate Services List
                                              (let (services_list (list))
                                                (let (services_with_sla_breach 0)
                                                  (do
                                                    (let (svc_keys (map_keys services_map))
                                                      (for sk svc_keys
                                                        (let (entry (map_get services_map sk))
                                                          (let (tot_req (map_get entry "total_requests"))
                                                            (let (cl_err (map_get entry "client_error_requests"))
                                                              (let (sv_err (map_get entry "server_error_requests"))
                                                                (let (tot_lat (map_get entry "total_latency_ms"))
                                                                  (let (err_rate (call round_4 (/ (to_float (+ cl_err sv_err)) (to_float tot_req))))
                                                                    (let (avg_lat (call round_2 (/ (to_float tot_lat) (to_float tot_req))))
                                                                      (let (is_breach (or (> err_rate error_rate_threshold) (> avg_lat (to_float sla_latency_ms))))
                                                                        (do
                                                                          (if is_breach
                                                                            (set services_with_sla_breach (+ services_with_sla_breach 1))
                                                                          )
                                                                          (let (svc_obj (dict
                                                                            ("service" sk)
                                                                            ("total_requests" tot_req)
                                                                            ("successful_requests" (map_get entry "successful_requests"))
                                                                            ("client_error_requests" cl_err)
                                                                            ("server_error_requests" sv_err)
                                                                            ("error_rate" err_rate)
                                                                            ("min_latency_ms" (map_get entry "min_latency_ms"))
                                                                            ("max_latency_ms" (map_get entry "max_latency_ms"))
                                                                            ("avg_latency_ms" avg_lat)
                                                                            ("total_bytes_sent" (map_get entry "total_bytes_sent"))
                                                                            ("sla_breach" is_breach)
                                                                          ))
                                                                            (append services_list svc_obj)
                                                                          )
                                                                        )
                                                                      )
                                                                    )
                                                                  )
                                                                )
                                                              )
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )

                                                    ;; Generate Top Clients List
                                                    (let (all_clients (list))
                                                      (do
                                                        (let (cl_keys (map_keys clients_map))
                                                          (for ck cl_keys
                                                            (append all_clients (map_get clients_map ck))
                                                          )
                                                        )
                                                        (let (sorted_clients (sort_by c all_clients (- 0 (map_get c "request_count"))))
                                                          (let (top_clients (if (> (list_len sorted_clients) 10) (list_slice sorted_clients 0 10) sorted_clients))

                                                            ;; Generate Windows List
                                                            (let (all_windows (list))
                                                              (do
                                                                (let (win_keys (map_keys windows_map))
                                                                  (for wk win_keys
                                                                    (let (w_entry (map_get windows_map wk))
                                                                      (let (tot_req (map_get w_entry "total_requests"))
                                                                        (let (tot_lat (map_get w_entry "total_latency_ms"))
                                                                          (let (avg_lat (call round_2 (/ (to_float tot_lat) (to_float tot_req))))
                                                                            (let (w_obj (dict
                                                                              ("window_start" (map_get w_entry "window_start"))
                                                                              ("window_end" (map_get w_entry "window_end"))
                                                                              ("total_requests" tot_req)
                                                                              ("error_requests" (map_get w_entry "error_requests"))
                                                                              ("avg_latency_ms" avg_lat)
                                                                            ))
                                                                              (append all_windows w_obj)
                                                                            )
                                                                          )
                                                                        )
                                                                      )
                                                                    )
                                                                  )
                                                                )
                                                                (let (sorted_windows all_windows)

                                                                  ;; Build Summary
                                                                  (let (summary_dict (if (= valid_records 0)
                                                                    (dict
                                                                      ("total_records" total_records)
                                                                      ("valid_records" 0)
                                                                      ("invalid_records" invalid_records)
                                                                      ("earliest_timestamp" (map_get (dict) "nil"))
                                                                      ("latest_timestamp" (map_get (dict) "nil"))
                                                                      ("total_bytes_sent" 0)
                                                                      ("total_services" 0)
                                                                      ("services_with_sla_breach" 0)
                                                                    )
                                                                    (dict
                                                                      ("total_records" total_records)
                                                                      ("valid_records" valid_records)
                                                                      ("invalid_records" invalid_records)
                                                                      ("earliest_timestamp" earliest_timestamp)
                                                                      ("latest_timestamp" latest_timestamp)
                                                                      ("total_bytes_sent" total_bytes_sent)
                                                                      ("total_services" (list_len services_list))
                                                                      ("services_with_sla_breach" services_with_sla_breach)
                                                                    )
                                                                  ))
                                                                    (let (final_services (if (= valid_records 0) (list) services_list))
                                                                      (let (final_clients (if (= valid_records 0) (list) top_clients))
                                                                        (let (final_windows (if (= valid_records 0) (list) sorted_windows))
                                                                          (let (report (dict
                                                                            ("summary" summary_dict)
                                                                            ("services" final_services)
                                                                            ("top_clients" final_clients)
                                                                            ("windows" final_windows)
                                                                          ))
                                                                            (let (report_json (encode_json report))
                                                                              (if (= output_path "-")
                                                                                (print report_json)
                                                                                (try_let (ignored (do (write_file output_path report_json) "ok"))
                                                                                  (catch err
                                                                                    (do
                                                                                      (stderr (str "Cannot write to output file: " output_path "\n"))
                                                                                      (exit 1)
                                                                                    )
                                                                                  )
                                                                                  "ok"
                                                                                )
                                                                              )
                                                                            )
                                                                          )
                                                                        )
                                                                      )
                                                                    )
                                                                  )
                                                                )
                                                              )
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
