(do
 (let (checks (parse_json Checks (read_text "evidence/checks.json"))
       version (read_text "evidence/version.kv")
       note (read_text "evidence/note.txt")
       selected (list))
  (do
   (for c checks (when (= (map_get c "name") "unit") (append selected c)))
   (write_file "out/approval_request.json" (encode_json (dict ("reason" "release review") ("summary" (dict ("batch" "26") ("selected" selected)))))))))
