(do
 (let (raw (read_text "evidence/checks.json"))
 (let (checks (parse_json Checks raw)
       lines (lines (read_file "evidence/version.kv"))
       note (read_text "evidence/note.txt")
       selected (list)
       failed (list))
  (do
   (for c checks (when (= (map_get c "name") "unit") (append selected c)))
   (for c checks (when (!= (map_get c "status") "PASS") (append failed c)))
   (let (cp (str_split (list_get lines 0) "=")
         pp (str_split (list_get lines 1) "=")
         cur (str_split (list_get cp 1) ".")
         pro (str_split (list_get pp 1) ".")
         c0 (to_int (list_get cur 0)) c1 (to_int (list_get cur 1)) c2 (to_int (list_get cur 2))
         p0 (to_int (list_get pro 0)) p1 (to_int (list_get pro 1)) p2 (to_int (list_get pro 2)))
    (if (and (= (list_len failed) 0) (or (> p0 c0) (and (= p0 c0) (or (> p1 c1) (and (= p1 c1) (> p2 c2))))))
     (write_file "out/release.json" (encode_json (dict ("batch" "12") ("selected" selected))))
     (write_file "out/approval_request.json" "{\"reason\":\"blocked\",\"summary\":{}}")))))))
