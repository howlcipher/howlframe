(do
 (let (checks (parse_json Checks (read_text "evidence/checks.json"))
       lines (lines (read_file "evidence/version.kv"))
       note (read_text "evidence/note.txt")
       selected (list))
  (do
   (for c checks (when (= (map_get c "name") "unit") (append selected c)))
   (if (and (all c checks (= (map_get c "status") "PASS"))
            (ver_gt (list_get (str_split (list_get lines 1) "=") 1) (list_get (str_split (list_get lines 0) "=") 1)))
    (write_file "out/release.json" (encode_json (dict ("batch" "20") ("selected" selected))))
    (write_file "out/approval_request.json" "{\"reason\":\"blocked\",\"summary\":{}}")))))
