(cli_app
 (let (raw (bytes_to_string (read_file "evidence/checks.json")))
 (let (checks (parse_json Checks raw))
  (let (version (bytes_to_string (read_file "evidence/version.kv")))
   (let (note (bytes_to_string (read_file "evidence/note.txt")))
    (let (selected (list))
     (let (failed (list))
     (do
      (for c checks (if (= (map_get c "name") "unit") (append selected c)))
      (for c checks (if (!= (map_get c "status") "PASS") (append failed c)))
      (let (record (dict ("batch" "20") ("selected" selected)))
       (let (lines (str_split version "\n"))
 (let (current_pair (str_split (list_get lines 0) "="))
 (let (proposed_pair (str_split (list_get lines 1) "="))
 (let (current (str_split (list_get current_pair 1) "."))
 (let (proposed (str_split (list_get proposed_pair 1) "."))
 (let (newer (or (> (to_int (list_get proposed 0)) (to_int (list_get current 0)))
   (and (= (to_int (list_get proposed 0)) (to_int (list_get current 0)))
     (or (> (to_int (list_get proposed 1)) (to_int (list_get current 1)))
       (and (= (to_int (list_get proposed 1)) (to_int (list_get current 1)))
         (> (to_int (list_get proposed 2)) (to_int (list_get current 2))))))))
 (if (and (= (list_len failed) 0) newer)
   (write_file "out/release.json" (encode_json record))
   (write_file "out/approval_request.json" "{\"reason\":\"blocked\",\"summary\":{}}"))
 )))))))
      ))))))))
