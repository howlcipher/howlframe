(do
 (let (raw (read_text "evidence/checks.json"))
 (let (checks (parse_json Checks raw)
       version (read_text "evidence/version.kv")
       note (read_text "evidence/note.txt")
       selected (list))
  (do
   (for c checks (when (= (map_get c "status") "PASS") (append selected c)))
   (write_file "out/release.json" (encode_json (dict ("batch" "01") ("selected" selected))))))))
