; Fresh requirements-first ledgerlens candidate. No external runtime helpers.
(cli_app
  (defun fatal ((code int) (message string)) void
    (do (stderr (str "ledgerlens: " message "\n")) (exit code)))
  (defun usage () string
    (return "usage: ledgerlens <summary|categorize|check-rules|version> [options] INPUT"))
  (defun spaces ((text string)) string
    (let (result text)
      (do
        (while (starts_with result " ") (set result (str_slice result 1)))
        (while (ends_with result " ") (set result (str_slice result 0 -1)))
        (return result))))
  (defun input_file ((path string)) string
    (do
      (try_let (data (read_file path))
        (catch error
          (do
            (if (regex_match "CAPABILITY_DENIED" error) (call fatal 77 "capability denied: filesystem"))
            (if (regex_match "LIMIT_EXCEEDED" error) (call fatal 70 "resource limit reached"))
            (call fatal 66 (str "cannot read " path))))
        (return (bytes_to_string data)))
      (return "")))
  (defun output ((path string) (text string)) void
    (if (= path "") (print text)
      (try_let (saved (do (write_file path (str text "\n")) 1))
        (catch error
          (do
            (if (regex_match "CAPABILITY_DENIED" error) (call fatal 77 "capability denied: filesystem"))
            (if (regex_match "LIMIT_EXCEEDED" error) (call fatal 70 "resource limit reached"))
            (call fatal 73 (str "cannot write " path))))
        (set saved saved))))
  (defun money ((cents int)) string
    (let (negative (< cents 0) absolute cents)
      (do
        (if negative (set absolute (- 0 cents)))
        (let (digits (pad_left (to_string absolute) 3 "0"))
          (return (str (if negative "-" "") (str_slice digits 0 -2) "." (str_slice digits -2)))))))
  (defun decimal_cents ((text string)) string
    (let (parts (str_split text ".") fraction "00")
      (do
        (if (= (list_len parts) 2) (set fraction (pad_right (list_get parts 1) 2 "0")))
        (let (result (str (list_get parts 0) fraction))
          (do
            (while (and (> (str_len result) 1) (starts_with result "0")) (set result (str_slice result 1)))
            (return result))))))
  (defun budget_text ((digits string)) string
    (let (padded (pad_left digits 3 "0"))
      (return (str (str_slice padded 0 -2) "." (str_slice padded -2)))))
  (defun date_valid ((text string)) bool
    (do
      (if (not (regex_match "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" text)) (return false))
      (let (year (to_int (str_slice text 0 4)) month (to_int (str_slice text 5 7)) day (to_int (str_slice text 8 10)) maximum 31)
        (do
          (if (or (< year 1900) (> year 2999) (< month 1) (> month 12) (< day 1)) (return false))
          (if (list_contains (list 4 6 9 11) month) (set maximum 30))
          (if (= month 2)
            (set maximum (if (or (= (% year 400) 0) (and (= (% year 4) 0) (!= (% year 100) 0))) 29 28)))
          (return (<= day maximum))))))
  (defun byte_count ((text string)) int
    (let (size 0 two (bytes_to_string (list 194 128)) three (bytes_to_string (list 224 160 128)) four (bytes_to_string (list 240 144 128 128)))
      (do
        (for ch (str_split text "")
          (set size (+ size (if (< ch two) 1 (if (< ch three) 2 (if (< ch four) 3 4))))))
        (return size))))
  ; CSV state machine: unquoted, quoted, after quote. No newline-spanning fields.
  (defun csv_fields ((text string)) dict
    (do
      (if (not (str_contains text "\""))
        (let (fields (list))
          (do
            (for field (str_split text ",") (append fields (call spaces field)))
            (return (dict ("fields" fields) ("error" ""))))))
    (let (chars (str_split text "") fields (list) current "" mode 0 index 0 count (str_len text) error "")
      (do
        (while (and (< index count) (= error ""))
          (let (ch (list_get chars index))
            (do
              (if (= mode 1)
                (if (= ch "\"")
                  (if (and (< (+ index 1) count) (= (list_get chars (+ index 1)) "\""))
                    (do (set current (str current "\"")) (set index (+ index 1)))
                    (set mode 2))
                  (set current (str current ch)))
                (if (= ch ",")
                  (do (append fields (if (= mode 2) current (call spaces current))) (set current "") (set mode 0))
                  (if (= mode 2) (set error "unexpected character after closing quote")
                    (if (= ch "\"")
                      (if (= current "") (set mode 1) (set error "quote inside unquoted field"))
                      (set current (str current ch))))))
              (set index (+ index 1)))))
        (if (= mode 1) (set error "unterminated quote"))
        (append fields (if (= mode 2) current (call spaces current)))
        (return (dict ("fields" fields) ("error" error)))))))
  (defun csv_quote ((text string)) string
    (if (or (str_contains text ",") (str_contains text "\"") (!= text (call spaces text)))
      (return (str "\"" (str_join (str_split text "\"") "\"\"") "\""))
      (return text)))
  (defun record_error ((errors dict) (line int) (message string)) void
    (if (< line (map_get errors "line"))
      (do (map_set errors "line" line) (map_set errors "message" message))))
  (defun rules ((path string)) dict
    (let (budgetmap (dict) rulelist (list) result (dict ("rules" (list)) ("budgets" (dict))) section "" known (dict) pending (dict) errors (dict ("line" 2000000000) ("message" "")) line 0)
      (do
        (if (= path "") (return result))
        (for raw (str_split (call input_file path) "\n")
          (do
            (set line (+ line 1))
            (let (text raw)
              (do
                (if (ends_with text "\r") (set text (str_slice text 0 -1)))
                (set text (call spaces text))
                (if (and (!= text "") (not (starts_with text "#")))
                  (if (list_contains (list "[categories]" "[budgets]") text) (set section text)
                    (do
                      (if (= section "") (call record_error errors line "entry outside a section"))
                      (if (not (str_contains text "=")) (call record_error errors line "expected NAME = VALUE"))
                      (let (parts (str_split text "="))
                        (let (name (call spaces (list_get parts 0)) value (call spaces (str_join (list_slice parts 1) "=")))
                          (if (= section "[categories]")
                            (do
                              (if (or (= name "Uncategorized") (not (regex_match "^[A-Za-z][A-Za-z0-9 _-]{0,39}$" name))) (call record_error errors line "invalid category name"))
                              (if (= value "") (call record_error errors line "empty regular expression"))
                              (try_let (valid (regex_match value ""))
                                (catch error (call record_error errors line "invalid regular expression"))
                                (set valid valid))
                              (map_set known name true)
                              (append rulelist (dict ("name" name) ("pattern" value))))
                            (do
                              (if (not (regex_match "^[0-9]+(\\.[0-9]{1,2})?$" value)) (call record_error errors line "invalid budget amount"))
                              (let (cents (call decimal_cents value))
                                (do
                                  (if (= cents "0") (call record_error errors line "budget must be greater than zero"))
                                  (if (map_has pending name) (call record_error errors line "duplicate budget") (map_set pending name line))
                                  (map_set budgetmap name cents))))))))))))))
        (for name (map_keys pending)
          (if (and (!= name "Uncategorized") (not (map_has known name))) (call record_error errors (map_get pending name) "budget for unknown category")))
        (if (< (map_get errors "line") 2000000000) (call fatal 65 (str "rules: line " (map_get errors "line") ": " (map_get errors "message"))))
        (map_set result "rules" rulelist)
        (map_set result "budgets" budgetmap)
        (return result))))
  (defun cli ((arguments list)) dict
    (let (n (list_len arguments) config (dict ("rules" "") ("month" "") ("format" "text") ("out" "") ("lenient" false) ("max-rows" 100000)) seen (dict) operands (list) index 1)
      (do
        (if (= n 0) (call fatal 2 "missing command"))
        (let (command (list_get arguments 0))
          (do
            (map_set config "command" command)
            (if (not (list_contains (list "summary" "categorize" "check-rules" "version" "help" "--help" "-h") command)) (call fatal 2 "unknown command"))
            (while (< index n)
              (let (arg (list_get arguments index))
                (do
                  (if (and (starts_with arg "-") (!= arg "-"))
                    (do
                      (if (not (list_contains (list "summary" "categorize") command)) (call fatal 2 "unexpected option"))
                      (if (not (list_contains (list "--rules" "--month" "--format" "--out" "--lenient" "--max-rows") arg)) (call fatal 2 "unknown option"))
                      (if (and (= command "categorize") (list_contains (list "--month" "--format") arg)) (call fatal 2 "option invalid for categorize"))
                      (if (map_has seen arg) (call fatal 2 "duplicate option"))
                      (map_set seen arg true)
                      (if (= arg "--lenient") (map_set config "lenient" true)
                        (do
                          (set index (+ index 1))
                          (if (>= index n) (call fatal 2 "missing option value"))
                          (map_set config (str_slice arg 2) (list_get arguments index)))))
                    (append operands arg))
                  (set index (+ index 1)))))
            (if (list_contains (list "summary" "categorize" "check-rules") command)
              (if (!= (list_len operands) 1) (call fatal 2 "expected one input"))
              (if (!= (list_len operands) 0) (call fatal 2 "unexpected operand")))
            (if (and (= command "categorize") (= (map_get config "rules") "")) (call fatal 2 "categorize requires --rules"))
            (if (not (list_contains (list "text" "json") (map_get config "format"))) (call fatal 2 "invalid format"))
            (let (month (map_get config "month") maximum (to_string (map_get config "max-rows")))
              (do
                (if (!= month "")
                  (if (not (and (regex_match "^[0-9]{4}-[0-9]{2}$" month) (call date_valid (str month "-01")))) (call fatal 2 "invalid month")))
                (while (and (> (str_len maximum) 1) (starts_with maximum "0")) (set maximum (str_slice maximum 1)))
                (if (or (not (regex_match "^[0-9]+$" maximum)) (> (str_len maximum) 8) (< (to_int maximum) 1) (> (to_int maximum) 10000000)) (call fatal 2 "invalid --max-rows"))
                (map_set config "max-rows" (to_int maximum))))
            (map_set config "operands" operands)
            (return config))))))
  (defun transaction_error ((fields list) (columns int) (di int) (ei int) (ai int)) string
    (do
      (if (!= (list_len fields) columns) (return "wrong number of fields"))
      (if (not (call date_valid (list_get fields di))) (return "invalid date"))
      (if (> (call byte_count (list_get fields ei)) 1000) (return "description too long"))
      (if (not (regex_match "^[+-]?[0-9]{1,12}(\\.[0-9]{1,2})?$" (list_get fields ai))) (return "invalid amount"))
      (return "")))
  (defun transactions ((config dict) (rulebook dict)) dict
    (let (path (list_get (map_get config "operands") 0) rows (list) skipped 0 physical 0 data_count 0 header false columns 0 di 0 ei 0 ai 0 text "")
      (do
        (set text (if (= path "-") (read_stdin) (call input_file path)))
        (if (starts_with text (bytes_to_string (list 239 187 191))) (set text (str_slice text 1)))
        (for raw (str_split text "\n")
          (do
            (set physical (+ physical 1))
            (let (line raw)
              (do
                (if (ends_with line "\r") (set line (str_slice line 0 -1)))
                (if (!= line "")
                  (let (parsed (call csv_fields line))
                    (let (fields (map_get parsed "fields") error (map_get parsed "error"))
                      (if (not header)
                        (do
                          (if (!= error "") (call fatal 65 (str "line 1: " error)))
                          (set columns (list_len fields))
                          (let (index 0 dates 0 descriptions 0 amounts 0)
                            (do
                              (for field fields
                                (do
                                  (let (name (to_lower (call spaces field)))
                                    (do
                                      (if (= name "date") (do (set dates (+ dates 1)) (set di index)))
                                      (if (= name "description") (do (set descriptions (+ descriptions 1)) (set ei index)))
                                      (if (= name "amount") (do (set amounts (+ amounts 1)) (set ai index)))))
                                  (set index (+ index 1))))
                              (if (or (!= dates 1) (!= descriptions 1) (!= amounts 1)) (call fatal 65 "line 1: invalid header"))))
                          (set header true))
                        (do
                          (set data_count (+ data_count 1))
                          (if (> data_count (map_get config "max-rows")) (call fatal 70 (str "row limit exceeded (max " (map_get config "max-rows") ")")))
                          (if (= error "") (set error (call transaction_error fields columns di ei ai)))
                          (if (!= error "")
                            (if (map_get config "lenient") (set skipped (+ skipped 1)) (call fatal 65 (str "line " physical ": " error)))
                            (let (amount (list_get fields ai) category "Uncategorized" description (list_get fields ei) negative false)
                              (do
                                (set negative (starts_with amount "-"))
                                (if (or negative (starts_with amount "+")) (set amount (str_slice amount 1)))
                                (for rule (map_get rulebook "rules")
                                  (if (and (= category "Uncategorized") (regex_match (map_get rule "pattern") description)) (set category (map_get rule "name"))))
                                (let (cents (to_int (call decimal_cents amount)))
                                  (append rows (dict ("date" (list_get fields di)) ("description" description) ("category" category) ("cents" (if negative (- 0 cents) cents)))))))))))))))))
        (if (not header) (call fatal 65 "empty input"))
        (return (dict ("rows" rows) ("skipped" skipped))))))
  ; Totals use base-1,000,000 limbs. Even the maximum supported row count
  ; and amount keep the high limb below 10^15, safely inside the VM integer
  ; range, while the combined exact cents may exceed int64. No float sums.
  (defun zero_total () dict
    (return (dict ("income" (dict ("hi" 0) ("lo" 0)))
                  ("expenses" (dict ("hi" 0) ("lo" 0))) ("count" 0))))
  (defun add_cents ((pair dict) (cents int)) void
    (let (low (+ (map_get pair "lo") (% cents 1000000)))
      (do
        (map_set pair "hi" (+ (+ (map_get pair "hi") (to_int (/ cents 1000000))) (to_int (/ low 1000000))))
        (map_set pair "lo" (% low 1000000)))))
  (defun pair_digits ((pair dict)) string
    (return (if (= (map_get pair "hi") 0) (to_string (map_get pair "lo"))
      (str (map_get pair "hi") (pad_left (to_string (map_get pair "lo")) 6 "0")))))
  (defun pair_greater ((left dict) (right dict)) bool
    (return (or (> (map_get left "hi") (map_get right "hi"))
      (and (= (map_get left "hi") (map_get right "hi")) (> (map_get left "lo") (map_get right "lo"))))))
  (defun large_money ((pair dict)) string
    (return (call budget_text (call pair_digits pair))))
  (defun net_money ((income dict) (expenses dict)) string
    (let (negative (call pair_greater expenses income))
      (let (larger (if negative expenses income) smaller (if negative income expenses))
        (let (hi (- (map_get larger "hi") (map_get smaller "hi")) lo (- (map_get larger "lo") (map_get smaller "lo")))
          (do
            (if (< lo 0) (do (set lo (+ lo 1000000)) (set hi (- hi 1))))
            (return (str (if negative "-" "") (call large_money (dict ("hi" hi) ("lo" lo))))))))))
  (defun accumulate ((table dict) (key string) (cents int)) void
    (do
      (if (not (map_has table key)) (map_set table key (call zero_total)))
      (let (row (map_get table key))
        (do
          (map_set row "count" (+ (map_get row "count") 1))
          (if (< cents 0) (call add_cents (map_get row "expenses") (- 0 cents))
            (call add_cents (map_get row "income") cents))))))
  (defun metric ((row dict)) dict
    (return (dict ("income" (call large_money (map_get row "income")))
      ("expenses" (call large_money (map_get row "expenses")))
      ("net" (call net_money (map_get row "income") (map_get row "expenses"))) ("count" (map_get row "count")))))
  (defun summary ((config dict) (rulebook dict) (rows list) (skipped int)) dict
    (let (months (dict) categories (dict) total (dict) mjson (list) cjson (list) bjson (list) mtext (list "# monthly" "month\tincome\texpenses\tnet\ttransactions") ctext (list "# categories" "month\tcategory\tincome\texpenses\ttransactions") btext (list "# budgets" "month\tcategory\tlimit\tspent\tstatus") exitcode 0)
      (do
        (map_set total "all" (call zero_total))
        (for row rows
          (let (month (str_slice (map_get row "date") 0 7) cents (map_get row "cents"))
            (if (or (= (map_get config "month") "") (= month (map_get config "month")))
              (do
                (call accumulate months month cents)
                (call accumulate categories (str month "|" (map_get row "category")) cents)
                (call accumulate total "all" cents)))))
        (for month (sort (map_keys months))
          (let (metric (call metric (map_get months month)))
            (do
              (map_set metric "month" month)
              (append mjson metric)
              (append mtext (str month "\t" (map_get metric "income") "\t" (map_get metric "expenses") "\t" (map_get metric "net") "\t" (map_get metric "count")))
              ; Insertion selection avoids numeric encodings with a hidden maximum.
              (let (remaining (dict))
                (do
                  (for key (map_keys categories)
                    (if (starts_with key (str month "|")) (map_set remaining key true)))
                  (while (> (list_len (map_keys remaining)) 0)
                    (let (best "" best_expense (dict ("hi" -1) ("lo" 0)))
                      (do
                        (for key (sort (map_keys remaining))
                          (let (expense (map_get (map_get categories key) "expenses"))
                            (if (call pair_greater expense best_expense) (do (set best key) (set best_expense expense)))))
                        (let (value (call metric (map_get categories best)) name (str_slice best 8))
                          (do
                            (map_delete value "net") (map_set value "month" month) (map_set value "category" name)
                            (append cjson value)
                            (append ctext (str month "\t" name "\t" (map_get value "income") "\t" (map_get value "expenses") "\t" (map_get value "count")))))
                        (map_delete remaining best))))))
              (for name (sort (map_keys (map_get rulebook "budgets")))
                (let (limit (map_get (map_get rulebook "budgets") name) spent (dict ("hi" 0) ("lo" 0)) status "OK" key (str month "|" name))
                  (do
                    (if (map_has categories key) (set spent (map_get (map_get categories key) "expenses")))
                    (let (digits (call pair_digits spent))
                      (if (or (> (str_len digits) (str_len limit)) (and (= (str_len digits) (str_len limit)) (> digits limit))) (do (set status "OVER") (set exitcode 1))))
                    (append bjson (dict ("month" month) ("category" name) ("limit" (call budget_text limit)) ("spent" (call large_money spent)) ("status" status)))
                    (append btext (str month "\t" name "\t" (call budget_text limit) "\t" (call large_money spent) "\t" status))))))))
        (let (totals (call metric (map_get total "all")) result "")
          (do
            (append mtext (str "TOTAL\t" (map_get totals "income") "\t" (map_get totals "expenses") "\t" (map_get totals "net") "\t" (map_get totals "count")))
            (if (= (map_get config "format") "json")
              (set result (encode_json (dict ("transactions" (map_get totals "count")) ("skipped" skipped) ("months" mjson) ("total" totals) ("categories" cjson) ("budgets" bjson))))
              (do
                (set result (str (str_join mtext "\n") "\n\n" (str_join ctext "\n")))
                (if (> (list_len (map_keys (map_get rulebook "budgets"))) 0) (set result (str result "\n\n" (str_join btext "\n"))))))
            (return (dict ("text" result) ("exit" exitcode))))))))
  (let (config (call cli (cli_args)))
    (let (command (map_get config "command"))
      (do
        (if (list_contains (list "help" "--help" "-h") command) (do (print (call usage)) (exit 0)))
        (if (= command "version") (do (print "ledgerlens 1.0.0") (exit 0)))
        (if (= command "check-rules")
          (let (book (call rules (list_get (map_get config "operands") 0)))
            (do (print (str "OK: " (list_len (map_get book "rules")) " rule(s), " (list_len (map_keys (map_get book "budgets"))) " budget(s)")) (exit 0))))
        (let (book (call rules (map_get config "rules")))
          (let (data (call transactions config book))
            (let (rows (map_get data "rows") skipped (map_get data "skipped") result "" status 0)
              (do
                (if (= command "categorize")
                  (let (lines (list "date,description,amount,category"))
                    (do
                      (for row rows (append lines (str (map_get row "date") "," (call csv_quote (map_get row "description")) "," (call money (map_get row "cents")) "," (call csv_quote (map_get row "category")))))
                      (set result (str_join lines "\n"))))
                  (let (report (call summary config book rows skipped))
                    (do (set result (map_get report "text")) (set status (map_get report "exit")))))
                (call output (map_get config "out") result)
                (if (> skipped 0) (stderr (str "ledgerlens: skipped " skipped " invalid row(s)\n")))
                (exit status))))))))
)
