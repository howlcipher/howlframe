; New implementation from frozen requirements. Prior healthwatch source was not read.
(cli_app
  (defun die (code message)
    (type_hints (code int) (message any) (return any))
    (do (stderr (str "healthwatch: " message "\n")) (exit code))
  )
  (defun bad (path) (type_hints (path any) (return any)) (call die 65 (str "config: " path ": invalid value")))
  (defun object (x) (type_hints (x any) (return any)) (return (starts_with (encode_json x) "{")))
  (defun array (x) (type_hints (x any) (return any)) (return (starts_with (encode_json x) "[")))
  (defun string (x) (type_hints (x any) (return any)) (return (starts_with (encode_json x) "\"")))
  (defun integer (x) (type_hints (x any) (return any)) (return (regex_match "^-?[0-9]+$" (encode_json x))))
  (defun boolean (x) (type_hints (x any) (return any)) (return (or (= (encode_json x) "true") (= (encode_json x) "false"))))
  (defun bounded (x lo hi)
    (type_hints (x any) (lo any) (hi any) (return any))
    (return (and (call integer x) (and (>= x lo) (<= x hi))))
  )
  (defun unknown (x allowed path)
    (type_hints (x any) (allowed any) (path any) (return any))
    (for k (sort (map_keys x)) (if (not (list_contains allowed k)) (call bad (str path k))))
  )
  (defun refs (x path allowed)
    (type_hints (x any) (path any) (allowed any) (return any))
    (do
      (if (not (call string x)) (call bad path))
      (if allowed
        (let (rest x)
          (while (str_contains rest "${")
            (do
              (set rest (str_slice rest (+ (str_len (list_get (str_split rest "${") 0)) 2)))
              (if (not (regex_match "^ENV:[A-Z_][A-Z0-9_]*}" rest)) (call bad path))
              (set rest (str_slice rest (+ (str_len (list_get (str_split rest "}") 0)) 1)))
            )
          )
        )
        (if (str_contains x "${ENV:") (call bad path))
      )
      (return x)
    )
  )
  (defun option_value (x key path)
    (type_hints (x any) (key any) (path any) (return any))
    (do
      (if (= key "method") (if (not (list_contains (list "GET" "HEAD" "POST" "PUT" "PATCH" "DELETE") x)) (call bad path)))
      (if (= key "expect_status")
        (if (call array x)
          (do (if (= (list_len x) 0) (call bad path)) (for v x (if (not (call bounded v 100 599)) (call bad path))))
          (if (not (call bounded x 100 599)) (call bad path))
        )
      )
      (if (= key "retries") (if (not (call bounded x 0 5)) (call bad path)))
      (if (= key "retry_delay_ms") (if (not (call bounded x 0 5000)) (call bad path)))
    )
  )
  (defun load (path missing)
    (type_hints (path any) (missing any) (return any))
    (try_let (raw (if (= path "-") (read_stdin) (bytes_to_string (read_file path))))
      (catch
        e
        (do
          (if (str_contains (to_string e) "CAPABILITY_DENIED") (call die 77 "capability denied: filesystem"))
          (if (and missing (str_contains (to_string e) "no such file"))
            (return (map_get (dict) "missing"))
            (call die 66 "input unavailable"))
        )
      )
      (return raw)
    )
  )
  (defun persist (path state)
    (type_hints (path any) (state any) (return any))
    (try_let (unused (do (write_file path (encode_json state)) true))
      (catch
        e
        (do
          (if (str_contains (to_string e) "CAPABILITY_DENIED") (call die 77 "capability denied: filesystem"))
          (call die 73 "state output unavailable")
        )
      )
      (return true)
    )
  )
  (defun config (raw)
    (type_hints (raw any) (return any))
    (try_let (cfg (parse_json Any raw))
      (catch e (call bad "$"))
      (do
        (if (not (call object cfg)) (call bad "$"))
        (if (!= (encode_json (map_get cfg "version")) "1") (call bad "version"))
        (let (defaults (dict ("method" "GET") ("expect_status" 200) ("retries" 0) ("retry_delay_ms" 0)))
          (do
            (let (keys (list "method" "expect_status" "retries" "retry_delay_ms"))
              (do
                (if (map_has cfg "defaults")
                  (let (d (map_get cfg "defaults"))
                    (do
                      (if (not (call object d)) (call bad "defaults"))
                      (for k keys (if (map_has d k) (do (call option_value (map_get d k) k (str "defaults." k)) (map_set defaults k (map_get d k)))))
                      (call unknown d keys "defaults.")
                    )
                  )
                )
                (let (checks (map_get cfg "checks"))
                  (do
                    (if (not (call array checks)) (call bad "checks"))
                    (if (= (list_len checks) 0) (call bad "checks"))
                    (if (> (list_len checks) 500) (call die 70 "check limit exceeded (max 500)"))
                    (let (seen (dict))
                      (do
                        (let (index 0)
                          (do
                            (for c checks
                              (do
                                (let (p (str "checks[" index "]."))
                                  (do
                                    (if (not (call object c)) (call bad (str "checks[" index "]")))
                                    (let (name (map_get c "name"))
                                      (do
                                        (if (not (call string name)) (call bad (str p "name")))
                                        (if (or (not (regex_match "^[A-Za-z0-9._-]{1,64}$" name)) (map_has seen name)) (call bad (str p "name")))
                                        (map_set seen name true)
                                        (let (url (call refs (map_get c "url") (str p "url") true))
                                          (do
                                            (if (not (regex_match "^https?://[^/?#[:space:]]+" url)) (call bad (str p "url")))
                                            (for k keys (if (not (map_has c k)) (map_set c k (map_get defaults k))))
                                            (call option_value (map_get c "method") "method" (str p "method"))
                                            (if (map_has c "body")
                                              (do
                                                (call refs (map_get c "body") (str p "body") true)
                                                (if (not (list_contains (list "POST" "PUT" "PATCH") (map_get c "method"))) (call bad (str p "body")))
                                              )
                                            )
                                            (call option_value (map_get c "expect_status") "expect_status" (str p "expect_status"))
                                            (if (map_has c "body_contains")
                                              (do
                                                (let (s (call refs (map_get c "body_contains") (str p "body_contains") false))
                                                  (do (if (or (= s "") (= (map_get c "method") "HEAD")) (call bad (str p "body_contains"))))
                                                )
                                              )
                                            )
                                            (if (map_has c "json_assert")
                                              (do
                                                (let (aa (map_get c "json_assert"))
                                                  (do
                                                    (if (or (not (call array aa)) (= (list_len aa) 0)) (call bad (str p "json_assert")))
                                                    (if (= (map_get c "method") "HEAD") (call bad (str p "json_assert")))
                                                    (let (j 0)
                                                      (do
                                                        (for a aa
                                                          (do
                                                            (let (ap (str p "json_assert[" j "]"))
                                                              (do
                                                                (if (not (call object a)) (call bad ap))
                                                                (let (path (call refs (map_get a "path") (str ap ".path") false))
                                                                  (do
                                                                    (if (= path "") (call bad (str ap ".path")))
                                                                    (if (= (map_has a "equals") (map_has a "exists")) (call bad ap))
                                                                    (if (map_has a "exists") (if (not (call boolean (map_get a "exists"))) (call bad ap)))
                                                                    (if (map_has a "equals")
                                                                      (do
                                                                        (let (v (map_get a "equals")) (do (if (or (call object v) (call array v)) (call bad ap)) (if (call string v) (call refs v ap false))))
                                                                      )
                                                                    )
                                                                    (call unknown a (list "path" "equals" "exists") (str ap "."))
                                                                    (set j (+ j 1))
                                                                  )
                                                                )
                                                              )
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                            (call option_value (map_get c "retries") "retries" (str p "retries"))
                                            (call option_value (map_get c "retry_delay_ms") "retry_delay_ms" (str p "retry_delay_ms"))
                                            (call unknown c (list "name" "url" "method" "body" "expect_status" "body_contains" "json_assert" "retries" "retry_delay_ms") p)
                                            (set index (+ index 1))
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                            (call unknown cfg (list "version" "defaults" "checks") "")
                            (return checks)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (defun state_load (path missing)
    (type_hints (path any) (missing any) (return any))
    (let (raw (call load path missing))
      (if (is_nil raw)
        (return (dict ("version" 1) ("checks" (dict))))
        (try_let (s (parse_json Any raw))
          (catch e (call die 65 "state: invalid JSON"))
          (do
            (if (not (call object s)) (call die 65 "state: invalid object"))
            (if (or (!= (encode_json (map_get s "version")) "1") (not (call object (map_get s "checks")))) (call die 65 "state: invalid schema"))
            (for k (map_keys (map_get s "checks"))
              (do
                (let (v (map_get (map_get s "checks") k))
                  (do
                    (do
                      (if (not (call object v)) (call die 65 "state: invalid entry"))
                      (if (not (map_has v "last_http_status")) (call die 65 "state: missing HTTP status"))
                    )
                    (if (or (not (list_contains (list "up" "down") (map_get v "health"))) (not (list_contains (list "PASS" "FAIL" "ERROR") (map_get v "last_status"))))
                      (call die 65 "state: invalid health")
                    )
                    (for f (list "since" "last_run" "consecutive_failures")
                      (if (not (call integer (map_get v f))) (call die 65 "state: invalid timestamp or count"))
                    )
                    (if (< (map_get v "consecutive_failures") 0) (call die 65 "state: invalid count"))
                    (if (and (not (is_nil (map_get v "last_http_status"))) (not (call integer (map_get v "last_http_status"))))
                      (call die 65 "state: invalid status")
                    )
                  )
                )
              )
            )
            (return s)
          )
        )
      )
    )
  )
  (defun expand (s path)
    (type_hints (s any) (path any) (return any))
    (let (out s)
      (do
        (do
          (while (str_contains out "${ENV:")
            (do
              (let (tail (str_slice out (+ (str_len (list_get (str_split out "${ENV:") 0)) 6)))
                (do
                  (let (name (str_slice tail 0 (str_len (list_get (str_split tail "}") 0))))
                    (do
                      (try_let (value (env name))
                        (catch e (call die 77 "capability denied: environment"))
                        (do
                          (if (or (is_nil value) (= value "")) (call die 65 (str "config: " path ": undefined environment variable " name)))
                          (set out (str_replace out (str "${ENV:" name "}") value))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
        (return out)
      )
    )
  )
  (defun assertion (doc a)
    (type_hints (doc any) (a any) (return any))
    (let (v doc)
      (let (found true)
        (do
          (for segment (str_split (map_get a "path") ".")
            (if found
              (if (call object v)
                (if (map_has v segment) (set v (map_get v segment)) (set found false))
                (if (call array v)
                  (if (regex_match "^(0|[1-9][0-9]*)$" segment)
                    (if (< (to_float segment) (list_len v)) (set v (list_get v (to_int segment))) (set found false))
                    (set found false)
                  )
                  (set found false)
                )
              )
            )
          )
          (if (map_has a "exists") (return (= found (map_get a "exists"))))
          (if (not found) (return false))
          (return (= v (map_get a "equals")))
        )
      )
    )
  )
  (defun attempt (c)
    (type_hints (c any) (return any))
    (try_let (response (http_request (map_get c "url") (map_get c "method") (if (map_has c "body") (map_get c "body") "")))
      (catch
        e
        (do
          (let (msg (to_string e))
            (do
              (if (str_contains msg "CAPABILITY_DENIED")
                (return (dict ("status" "DENIED") ("reason" "capability_denied") ("http_status" (map_get (dict) "missing"))))
              )
              (return
                (dict
                  ("status" "ERROR")
                  ("reason" (if (str_contains msg "LIMIT_EXCEEDED") "response_too_large" "request_failed"))
                  ("http_status" (map_get (dict) "missing"))
                )
              )
            )
          )
        )
      )
      (do
        (let (code (map_get response "status"))
          (do
            (let (body (bytes_to_string (map_get response "body")))
              (do
                (let (reason "ok")
                  (do
                    (let (expected (map_get c "expect_status"))
                      (do
                        (if (not (if (call array expected) (list_contains expected code) (= expected code))) (set reason "status_mismatch"))
                        (if (and (= reason "ok") (map_has c "body_contains"))
                          (if (not (str_contains body (map_get c "body_contains"))) (set reason "body_missing"))
                        )
                        (if (and (= reason "ok") (map_has c "json_assert"))
                          (try_let (doc (parse_json Any body))
                            (catch e (set reason "json_invalid"))
                            (for a (map_get c "json_assert") (if (and (= reason "ok") (not (call assertion doc a))) (set reason "json_mismatch")))
                          )
                        )
                        (return (dict ("status" (if (= reason "ok") "PASS" "FAIL")) ("reason" reason) ("http_status" code)))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (defun main ()
    (type_hints (return any))
    (do
      (let (args (cli_args))
        (do
          (if (= (list_len args) 0) (call die 2 "usage error"))
          (let (cmd (list_get args 0))
            (do
              (if (list_contains (list "help" "--help" "-h") cmd) (do (print "usage: healthwatch run|validate|status|version") (exit 0)))
              (if (= cmd "version") (do (if (!= (list_len args) 1) (call die 2 "usage error")) (print "healthwatch 1.0.0") (exit 0)))
              (if (not (list_contains (list "run" "validate" "status") cmd)) (call die 2 "usage error"))
              (let (format "text")
                (do
                  (let (state_path "")
                    (do
                      (let (operand "")
                        (do
                          (let (fail_down false)
                            (do
                              (let (seen (dict))
                                (do
                                  (let (i 1)
                                    (do
                                      (while (< i (list_len args))
                                        (do
                                          (let (a (list_get args i))
                                            (do
                                              (if (or (= a "--format") (= a "--state"))
                                                (do
                                                  (if (or (= cmd "validate") (and (= a "--state") (!= cmd "run"))) (call die 2 "usage error"))
                                                  (if (map_has seen a) (call die 2 "usage error"))
                                                  (map_set seen a true)
                                                  (set i (+ i 1))
                                                  (if (>= i (list_len args)) (call die 2 "usage error"))
                                                  (let (v (list_get args i))
                                                    (do
                                                      (if (= a "--format")
                                                        (do (if (not (list_contains (list "text" "json") v)) (call die 2 "usage error")) (set format v))
                                                        (set state_path v)
                                                      )
                                                    )
                                                  )
                                                )
                                                (if (= a "--fail-if-down")
                                                  (do (if (or (!= cmd "status") fail_down) (call die 2 "usage error")) (set fail_down true))
                                                  (do (if (or (and (starts_with a "-") (!= a "-")) (!= operand "")) (call die 2 "usage error")) (set operand a))
                                                )
                                              )
                                              (set i (+ i 1))
                                            )
                                          )
                                        )
                                      )
                                      (if (= operand "") (call die 2 "usage error"))
                                      (if (= cmd "status")
                                        (do
                                          (let (state (call state_load operand false))
                                            (do
                                              (let (entries (map_get state "checks"))
                                                (do
                                                  (let (rows (list))
                                                    (do
                                                      (let (down false)
                                                        (do
                                                          (for name (sort (map_keys entries))
                                                            (do
                                                              (let (v (map_get entries name))
                                                                (do
                                                                  (map_set v "name" name)
                                                                  (append rows v)
                                                                  (if (= (map_get v "health") "down") (set down true))
                                                                  (if (= format "text")
                                                                    (print
                                                                      (str_join
                                                                        (list
                                                                          (map_get v "health")
                                                                          name
                                                                          (to_string (map_get v "since"))
                                                                          (to_string (map_get v "last_run"))
                                                                          (map_get v "last_status")
                                                                          (if (is_nil (map_get v "last_http_status")) "-" (to_string (map_get v "last_http_status")))
                                                                          (to_string (map_get v "consecutive_failures"))
                                                                        )
                                                                        "\t"
                                                                      )
                                                                    )
                                                                  )
                                                                )
                                                              )
                                                            )
                                                          )
                                                          (if (= format "json") (print (encode_json (dict ("checks" rows)))))
                                                          (exit (if (and down fail_down) 1 0))
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                      (let (checks (call config (call load operand false)))
                                        (do
                                          (if (= cmd "validate") (do (print (str "OK: " (list_len checks) " check(s)")) (exit 0)))
                                          (let (idx 0)
                                            (do
                                              (for c checks
                                                (do
                                                  (map_set c "url" (call expand (map_get c "url") (str "checks[" idx "].url")))
                                                  (if (map_has c "body") (map_set c "body" (call expand (map_get c "body") (str "checks[" idx "].body"))))
                                                  (set idx (+ idx 1))
                                                )
                                              )
                                              (let (state (dict ("version" 1) ("checks" (dict))))
                                                (do
                                                  (if (!= state_path "") (do (set state (call state_load state_path true)) (call persist state_path state)))
                                                  (let (entries (map_get state "checks"))
                                                    (do
                                                      (let (names (dict))
                                                        (do
                                                          (let (results (list))
                                                            (do
                                                              (let (events (list))
                                                                (do
                                                                  (let (summary (dict ("pass" 0) ("fail" 0) ("error" 0) ("denied" 0)))
                                                                    (do
                                                                      (let (exit_code 0)
                                                                        (do
                                                                          (for c checks
                                                                            (do
                                                                              (let (r (dict))
                                                                                (do
                                                                                  (let (n 0)
                                                                                    (do
                                                                                      (let (again true)
                                                                                        (do
                                                                                          (while again
                                                                                            (do
                                                                                              (if (> n 0) (sleep (map_get c "retry_delay_ms")))
                                                                                              (set r (call attempt c))
                                                                                              (set n (+ n 1))
                                                                                              (set again (and (<= n (map_get c "retries")) (list_contains (list "FAIL" "ERROR") (map_get r "status"))))
                                                                                            )
                                                                                          )
                                                                                          (let (name (map_get c "name"))
                                                                                            (do
                                                                                              (let (status (map_get r "status"))
                                                                                                (do
                                                                                                  (map_set r "name" name)
                                                                                                  (map_set r "attempts" n)
                                                                                                  (append results r)
                                                                                                  (map_set names name true)
                                                                                                  (let (bucket (to_lower status))
                                                                                                    (do
                                                                                                      (map_set summary bucket (+ 1 (map_get summary bucket)))
                                                                                                      (if (= status "DENIED")
                                                                                                        (do (set exit_code 77) (stderr (str "healthwatch: capability denied: network (" name ")\n")))
                                                                                                        (do
                                                                                                          (if (and (!= status "PASS") (!= exit_code 77)) (set exit_code 1))
                                                                                                          (if (!= state_path "")
                                                                                                            (do
                                                                                                              (let (now (time_now))
                                                                                                                (do
                                                                                                                  (let (health (if (= status "PASS") "up" "down"))
                                                                                                                    (do
                                                                                                                      (let (old (map_get entries name))
                                                                                                                        (do
                                                                                                                          (let (kind "")
                                                                                                                            (do
                                                                                                                              (let (since now)
                                                                                                                                (do
                                                                                                                                  (let (failures (if (= health "up") 0 1))
                                                                                                                                    (do
                                                                                                                                      (if (is_nil old)
                                                                                                                                        (set kind "new")
                                                                                                                                        (if (!= health (map_get old "health"))
                                                                                                                                          (set kind (if (= health "up") "recovered" "down"))
                                                                                                                                          (do (set since (map_get old "since")) (if (= health "down") (set failures (+ 1 (map_get old "consecutive_failures")))))
                                                                                                                                        )
                                                                                                                                      )
                                                                                                                                      (if (!= kind "") (append events (dict ("kind" kind) ("name" name))))
                                                                                                                                      (map_set
                                                                                                                                        entries
                                                                                                                                        name
                                                                                                                                        (dict
                                                                                                                                          ("health" health)
                                                                                                                                          ("since" since)
                                                                                                                                          ("last_run" now)
                                                                                                                                          ("last_status" status)
                                                                                                                                          ("last_http_status" (map_get r "http_status"))
                                                                                                                                          ("consecutive_failures" failures)
                                                                                                                                        )
                                                                                                                                      )
                                                                                                                                    )
                                                                                                                                  )
                                                                                                                                )
                                                                                                                              )
                                                                                                                            )
                                                                                                                          )
                                                                                                                        )
                                                                                                                      )
                                                                                                                    )
                                                                                                                  )
                                                                                                                )
                                                                                                              )
                                                                                                            )
                                                                                                          )
                                                                                                        )
                                                                                                      )
                                                                                                    )
                                                                                                  )
                                                                                                )
                                                                                              )
                                                                                            )
                                                                                          )
                                                                                        )
                                                                                      )
                                                                                    )
                                                                                  )
                                                                                )
                                                                              )
                                                                            )
                                                                          )
                                                                          (if (!= state_path "")
                                                                            (do
                                                                              (for name (sort (map_keys entries))
                                                                                (if (not (map_has names name)) (do (map_delete entries name) (append events (dict ("kind" "removed") ("name" name)))))
                                                                              )
                                                                              (call persist state_path state)
                                                                            )
                                                                          )
                                                                          (if (= format "json")
                                                                            (print (encode_json (dict ("results" results) ("events" events) ("summary" summary))))
                                                                            (do
                                                                              (for r results
                                                                                (print
                                                                                  (str_join
                                                                                    (list
                                                                                      (map_get r "status")
                                                                                      (map_get r "name")
                                                                                      (if (is_nil (map_get r "http_status")) "-" (to_string (map_get r "http_status")))
                                                                                      (to_string (map_get r "attempts"))
                                                                                      (map_get r "reason")
                                                                                    )
                                                                                    "\t"
                                                                                  )
                                                                                )
                                                                              )
                                                                              (for e events (print (str_join (list "EVENT" (map_get e "kind") (map_get e "name")) "\t")))
                                                                              (print
                                                                                (str
                                                                                  "SUMMARY\tpass="
                                                                                  (map_get summary "pass")
                                                                                  "\tfail="
                                                                                  (map_get summary "fail")
                                                                                  "\terror="
                                                                                  (map_get summary "error")
                                                                                  "\tdenied="
                                                                                  (map_get summary "denied")
                                                                                )
                                                                              )
                                                                            )
                                                                          )
                                                                          (exit exit_code)
                                                                        )
                                                                      )
