(cli_app
  (store_open kv "memory://session")
  (let (args (cli_args))
    (let (argc (list_len args))
      (let (i 0)
        (while (< i argc)
          (do
            (let (cmd (list_get args i))
              (if (= cmd "add")
                (do
                  (set i (+ i 1))
                  (if (< i argc)
                    (do
                      (let (title (list_get args i))
                        (do
                          (let (next_id_rec (store_get kv "next_id"))
                            (let (next_id 1)
                              (do
                                (if (is_nil next_id_rec)
                                  (set next_id 1)
                                  (let (val_str (map_get next_id_rec "val"))
                                    (set next_id (to_int val_str))
                                  )
                                )
                                (let (id_str (to_string next_id))
                                  (do
                                    (let (todo (dict ("id" id_str) ("title" title) ("status" "open")))
                                      (store_put kv id_str todo)
                                    )
                                    (let (new_next_id (+ next_id 1))
                                      (store_put kv "next_id" (dict ("val" (to_string new_next_id))))
                                    )
                                    (print "ADDED" id_str title)
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                    (do
                      (print "ERROR: add requires a title")
                      (exit 1)
                    )
                  )
                )
                (if (= cmd "list")
                  (do
                    (let (next_id_rec (store_get kv "next_id"))
                      (let (max_id 1)
                        (do
                          (if (is_nil next_id_rec)
                            (set max_id 1)
                            (let (val_str (map_get next_id_rec "val"))
                              (set max_id (to_int val_str))
                            )
                          )
                          (let (curr 1)
                            (while (< curr max_id)
                              (do
                                (let (todo (store_get kv (to_string curr)))
                                  (if (is_nil todo)
                                    (set curr curr)
                                    (let (status (map_get todo "status"))
                                      (let (title (map_get todo "title"))
                                        (print curr "[" status "]" title)
                                      )
                                    )
                                  )
                                )
                                (set curr (+ curr 1))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                  (if (= cmd "get")
                    (do
                      (set i (+ i 1))
                      (if (< i argc)
                        (let (id_str (list_get args i))
                          (let (todo (store_get kv id_str))
                            (if (is_nil todo)
                              (do
                                (print "ERROR: not found")
                                (exit 1)
                              )
                              (let (status (map_get todo "status"))
                                (let (title (map_get todo "title"))
                                  (print id_str "[" status "]" title)
                                )
                              )
                            )
                          )
                        )
                        (do
                          (print "ERROR: get requires an id")
                          (exit 1)
                        )
                      )
                    )
                    (if (= cmd "complete")
                      (do
                        (set i (+ i 1))
                        (if (< i argc)
                          (let (id_str (list_get args i))
                            (let (todo (store_get kv id_str))
                              (if (is_nil todo)
                                (do
                                  (print "ERROR: not found")
                                  (exit 1)
                                )
                                (let (status (map_get todo "status"))
                                  (if (= status "done")
                                    (print "ALREADY COMPLETE" id_str)
                                    (do
                                      (let (title (map_get todo "title"))
                                        (let (new_todo (dict ("id" id_str) ("title" title) ("status" "done")))
                                          (store_put kv id_str new_todo)
                                        )
                                      )
                                      (print "COMPLETED" id_str)
                                    )
                                  )
                                )
                              )
                            )
                          )
                          (do
                            (print "ERROR: complete requires an id")
                            (exit 1)
                          )
                        )
                      )
                      (if (= cmd "delete")
                        (do
                          (set i (+ i 1))
                          (if (< i argc)
                            (let (id_str (list_get args i))
                              (let (todo (store_get kv id_str))
                                (if (is_nil todo)
                                  (do
                                    (print "ERROR: not found")
                                    (exit 1)
                                  )
                                  (do
                                    (store_delete kv id_str)
                                    (print "DELETED" id_str)
                                  )
                                )
                              )
                            )
                            (do
                              (print "ERROR: delete requires an id")
                              (exit 1)
                            )
                          )
                        )
                        (do
                          (print "UNKNOWN CMD:" cmd)
                          (exit 1)
                        )
                      )
                    )
                  )
                )
              )
            )
            (set i (+ i 1))
          )
        )
      )
    )
  )
)
