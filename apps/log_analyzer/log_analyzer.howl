(cli_app
  (let (log_file (cli_args 0))
    (if (= log_file "")
      (do
        (print "HowlFrame Log Analyzer")
        (print "Usage: log_analyzer <log-file>")
        (exit 2)
      )
      (try_let (content (read_file log_file))
        (catch err
          (do
            (print "HowlFrame Log Analyzer")
            (print "file=" log_file)
            (print "error=" err)
            (exit 2)
          )
        )
        (let (content_str (bytes_to_string content))
          (let (lines (str_split content_str "\n"))
            (let (errors 0)
              (let (warnings 0)
                (let (todos 0)
                  (let (line_count 0)
                    (do
                      (for line lines
                        (do
                          (set line_count (+ line_count 1))
                          (if (regex_match "ERROR|FATAL" line)
                            (set errors (+ errors 1))
                            (do
                              (if (regex_match "WARN|WARNING" line)
                                (set warnings (+ warnings 1))
                                (if (regex_match "TODO|FIXME" line)
                                  (set todos (+ todos 1))
                                )
                              )
                            )
                          )
                        )
                      )
                      (print "HowlFrame Log Analyzer")
                      (print "file=" log_file)
                      (print "lines=" line_count)
                      (print "errors=" errors)
                      (print "warnings=" warnings)
                      (print "todo=" todos)
                      (if (> errors 0)
                        (do
                          (print "status=ATTENTION")
                          (exit 1)
                        )
                        (do
                          (print "status=CLEAN")
                          (exit 0)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
