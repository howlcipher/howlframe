(do
  (let (f (cli_args 0))
    (if (= f "")
      (do (print "HowlFrame Log Analyzer") (print "Usage: log_analyzer <log-file>") (exit 2))
      (try_let (c (read_file f))
        (catch e (do (print "HowlFrame Log Analyzer") (print "file=" f) (print "error=" e) (exit 2)))
        (let (all (lines c) errors 0 warnings 0 todos 0)
          (do
            (for line all
              (cond
                ((regex_match "ERROR|FATAL" line) (set errors (+ errors 1)))
                ((regex_match "WARN|WARNING" line) (set warnings (+ warnings 1)))
                ((regex_match "TODO|FIXME" line) (set todos (+ todos 1)))))
            (print "HowlFrame Log Analyzer")
            (print "file=" f)
            (print "lines=" (list_len all))
            (print "errors=" errors)
            (print "warnings=" warnings)
            (print "todo=" todos)
            (if (> errors 0)
              (do (print "status=ATTENTION") (exit 1))
              (do (print "status=CLEAN") (exit 0)))))))))
