(http_server 8091

  (defun next_task_id ()
    (do
      (store_open kv "memory://session")
      (let (rec (store_get kv "next_id"))
        (let (n 1)
          (do
            (if (is_nil rec)
              (set n 1)
              (let (v (map_get rec "val"))
                (set n (to_int v))
              )
            )
            (store_put kv "next_id" (dict ("val" (to_string (+ n 1)))))
            (return (to_string n))
          )
        )
      )
    )
  )

  (route "/tasks/create" (lambda (req)
    (try_let (body (parse_json TaskInput req.body))
      (catch parse_err
        (res_json 400 (dict ("error" "invalid_json")))
      )
      (let (title (map_get body "title"))
        (if (= title "")
          (res_json 400 (dict ("error" "title_required")))
          (let (id (call next_task_id))
            (let (task (dict ("id" id) ("title" title) ("status" "open")))
              (do
                (store_open kv "memory://session")
                (store_put kv id task)
                (res_json 201 task)
              )
            )
          )
        )
      )
    )
  ))

  (route "/tasks/list" (lambda (req)
    (do
      (store_open kv "memory://session")
      (let (next_rec (store_get kv "next_id"))
        (let (max_id 1)
          (do
            (if (is_nil next_rec)
              (set max_id 1)
              (let (v (map_get next_rec "val"))
                (set max_id (to_int v))
              )
            )
            (let (tasks (list))
              (let (curr 1)
                (do
                  (while (< curr max_id)
                    (do
                      (let (t (store_get kv (to_string curr)))
                        (if (is_nil t)
                          (do)
                          (append tasks t)
                        )
                      )
                      (set curr (+ curr 1))
                    )
                  )
                  (res_json 200 (dict ("tasks" tasks)))
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/tasks/get" (lambda (req)
    (try_let (body (parse_json TaskInput req.body))
      (catch parse_err
        (res_json 400 (dict ("error" "invalid_json")))
      )
      (let (id (map_get body "id"))
        (if (= id "")
          (res_json 400 (dict ("error" "id_required")))
          (do
            (store_open kv "memory://session")
            (let (task (store_get kv id))
              (if (is_nil task)
                (res_json 404 (dict ("error" "not_found")))
                (res_json 200 task)
              )
            )
          )
        )
      )
    )
  ))

  (route "/tasks/complete" (lambda (req)
    (try_let (body (parse_json TaskInput req.body))
      (catch parse_err
        (res_json 400 (dict ("error" "invalid_json")))
      )
      (let (id (map_get body "id"))
        (if (= id "")
          (res_json 400 (dict ("error" "id_required")))
          (do
            (store_open kv "memory://session")
            (let (task (store_get kv id))
              (if (is_nil task)
                (res_json 404 (dict ("error" "not_found")))
                (let (title (map_get task "title"))
                  (let (updated (dict ("id" id) ("title" title) ("status" "done")))
                    (do
                      (store_put kv id updated)
                      (res_json 200 updated)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/tasks/delete" (lambda (req)
    (try_let (body (parse_json TaskInput req.body))
      (catch parse_err
        (res_json 400 (dict ("error" "invalid_json")))
      )
      (let (id (map_get body "id"))
        (if (= id "")
          (res_json 400 (dict ("error" "id_required")))
          (do
            (store_open kv "memory://session")
            (let (task (store_get kv id))
              (if (is_nil task)
                (res_json 404 (dict ("error" "not_found")))
                (do
                  (store_delete kv id)
                  (res_json 200 (dict ("deleted" id)))
                )
              )
            )
          )
        )
      )
    )
  ))
)
