(do
  (let (pat (cli_args 0) path (cli_args 1))
    (if (or (= pat "") (= path ""))
      (do (print "Usage: grep_cli <pattern> <file>") (exit 2))
      (try_let (raw (read_file path))
        (catch e (do (print (str_join (list "error=" (to_string e)) "")) (exit 2)))
        (let (rows (lines raw) n 0)
          (do
            (for row rows
              (if (regex_match pat row)
                (do (inc n) (print row))))
            (print (str_join (list "hits=" (to_string n)) ""))
            (if (> n 0) (exit 0) (exit 1))))))))
