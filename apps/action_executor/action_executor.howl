(cli_app
  (let (proposal_path (cli_args 0))
    (if (= proposal_path "")
      (do
        (stderr "usage: action_executor <proposal.json> [evidence...]")
        (exit 2))
      (try_let (content_bytes (read_file proposal_path))
        (catch err
          (do
            (stderr "Failed to read proposal file")
            (exit 3)))
        (let (content (bytes_to_string content_bytes))
          (try_let (proposal (parse_json Proposal content))
            (catch err
              (do
                (stderr "Failed to parse proposal")
                (exit 3)))
            (let (action (map_get proposal "action"))
              (do
                (if (is_nil action)
                  (set action "unknown")
                )
                (let (prop_artifact (map_get proposal "artifact"))
                  (do
                    (if (is_nil prop_artifact)
                      (set prop_artifact "unknown")
                    )
                    (let (trusted_approval "no")
                      (let (sandbox_dir "sandbox")
                        (let (current_state "idle")
                          (do
                            (for arg (cli_args)
                              (let (parts (str_split arg "="))
                                (let (key "")
                                  (let (val "")
                                    (let (i 0)
                                      (do
                                        (for p parts
                                          (do
                                            (if (= i 0) (set key p))
                                            (if (= i 1) (set val p))
                                            (set i (+ i 1))))
                                        (if (= key "approved") (set trusted_approval val))
                                        (if (= key "sandbox") (set sandbox_dir val))
                                        (if (= key "state") (set current_state val))
                                      ))))))
                            (let (decision "DENY")
                              (let (reason "unknown action")
                                (let (trusted_action_id "none")
                                  (let (normalized_target "none")
                                    (do
                                      (do

                                        (if (= action "read_release_status")
                                          (do
                                            (set decision "ALLOW")
                                            (set reason "read status is always allowed")
                                            (set trusted_action_id "read_release_status")
                                          )
                                        )
                                        (if (= action "run_health_check")
                                          (do
                                            (set decision "ALLOW")
                                            (set reason "health check is always allowed")
                                            (set trusted_action_id "run_health_check")
                                          )
                                        )
                                        (if (= action "stage_artifact")
                                          (do
                                            (if (or (= prop_artifact "app-v1") (= prop_artifact "app-v2"))
                                              (do
                                                (set decision "ALLOW")
                                                (set reason "staging allowed artifact")
                                                (set trusted_action_id "stage_artifact")
                                                (set normalized_target prop_artifact)
                                              )
                                              (do
                                                (set decision "DENY")
                                                (set reason "unauthorized artifact")
                                              )
                                            )
                                          )
                                        )
                                        (if (= action "write_release_marker")
                                          (if (= current_state "staged")
                                            (if (= trusted_approval "yes")
                                              (do
                                                (set decision "ALLOW")
                                                (set reason "marker write approved")
                                                (set trusted_action_id "write_release_marker")
                                              )
                                              (do
                                                (set decision "REQUIRE_APPROVAL")
                                                (set reason "marker write requires approval")
                                              )
                                            )
                                            (do
                                              (set decision "DENY")
                                              (set reason "must be staged to deploy")
                                            )
                                          )
                                        )
                                        (if (= action "rollback_marker")
                                          (if (= current_state "production_deployed")
                                            (if (= trusted_approval "yes")
                                              (do
                                                (set decision "ALLOW")
                                                (set reason "rollback approved")
                                                (set trusted_action_id "rollback_marker")
                                              )
                                              (do
                                                (set decision "REQUIRE_APPROVAL")
                                                (set reason "rollback requires approval")
                                              )
                                            )
                                            (do
                                              (set decision "DENY")
                                              (set reason "can only rollback from production_deployed")
                                            )
                                          )
                                        )

                                        (print "{")
                                        (print (str_join (list "  \"decision\": \"" decision "\",") ""))
                                        (print (str_join (list "  \"action_id\": \"" trusted_action_id "\",") ""))
                                        (print (str_join (list "  \"normalized_target\": \"" normalized_target "\",") ""))
                                        (print (str_join (list "  \"reason\": \"" reason "\"") ""))
                                        (print "}")

                                        (if (= decision "ALLOW")
                                          (do
                                            (if (= trusted_action_id "read_release_status")
                                              (do
                                                (store_open kv2 "memory://release_state")
                                                (let (status_dict2 (store_get kv2 "status"))
                                                  (if (is_nil status_dict2)
                                                    (print "status=idle")
                                                    (let (val2 (map_get status_dict2 "val"))
                                                      (print (str_join (list "status=" (to_string val2)) ""))
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                            (if (= trusted_action_id "run_health_check")
                                              (do
                                                (let (marker_path (str_join (list sandbox_dir "/releases/current.txt") ""))
                                                  (try_let (marker_bytes (read_file marker_path))
                                                    (catch err (print "health=error_no_marker"))
                                                    (print (str_join (list "health=ok_marker_" (bytes_to_string marker_bytes)) ""))
                                                  )
                                                )
                                              )
                                            )
                                            (if (= trusted_action_id "stage_artifact")
                                              (do
                                                (let (fixture_path (str_join (list "fixtures/" normalized_target ".txt") ""))
                                                  (let (target_path (str_join (list sandbox_dir "/staged/" normalized_target ".txt") ""))
                                                    (try_let (data (read_file fixture_path))
                                                      (catch err (do (stderr "Fixture not found") (exit 4)))
                                                      (do
                                                        (write_file target_path data)
                                                        (store_open kv3 "memory://release_state")
                                                        (store_put kv3 "status" (dict ("val" "staged")))
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                            (if (= trusted_action_id "write_release_marker")
                                              (do
                                                (let (marker_path (str_join (list sandbox_dir "/releases/current.txt") ""))
                                                  (do
                                                    (write_file marker_path "production_deployed")
                                                    (store_open kv4 "memory://release_state")
                                                    (store_put kv4 "status" (dict ("val" "production_deployed")))
                                                  )
                                                )
                                              )
                                            )
                                            (if (= trusted_action_id "rollback_marker")
                                              (do
                                                (let (marker_path (str_join (list sandbox_dir "/releases/current.txt") ""))
                                                  (do
                                                    (write_file marker_path "rolled_back")
                                                    (store_open kv5 "memory://release_state")
                                                    (store_put kv5 "status" (dict ("val" "rolled_back")))
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
