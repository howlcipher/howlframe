(do
  (let (needle (cli_args 0) path (cli_args 1))
    (if (or (blank needle) (blank path))
      (do (print "Usage: icontains_cli <needle> <file>") (exit 2))
      (try_let (s (read_text path))
        (catch e (do (print "error=" e) (exit 2)))
        (if (str_contains (to_lower s) (to_lower needle))
          (do (print "FOUND") (exit 0))
          (do (print "MISSING") (exit 1)))))))
