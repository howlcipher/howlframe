(cli_app
  (store_open kv "memory://session")
  (let (args (cli_args))
    (let (argc (list_len args))
      (let (i 0)
        (while (< i argc)
          (do
            (let (cmd (list_get args i))
              (if (= cmd "set")
                (do
                  (set i (+ i 1))
                  (let (k (list_get args i))
                    (do
                      (set i (+ i 1))
                      (let (v (list_get args i))
                        (do
                          (store_put kv k (dict ("val" v)))
                          (print "OK")
                        )
                      )
                    )
                  )
                )
                (if (= cmd "get")
                  (do
                    (set i (+ i 1))
                    (let (k (list_get args i))
                      (let (record (store_get kv k))
                        (if (is_nil record)
                          (print "NOT FOUND")
                          (let (v (map_get record "val"))
                            (print v)
                          )
                        )
                      )
                    )
                  )
                  (if (= cmd "delete")
                    (do
                      (set i (+ i 1))
                      (let (k (list_get args i))
                        (do
                          (store_delete kv k)
                          (print "OK")
                        )
                      )
                    )
                    (if (= cmd "increment")
                      (do
                        (set i (+ i 1))
                        (let (k (list_get args i))
                          (let (record (store_get kv k))
                            (let (current 0)
                              (do
                                (if (is_nil record)
                                  (set current current)
                                  (let (val_str (map_get record "val"))
                                    (set current (to_int val_str))
                                  )
                                )
                                (let (next_val (+ current 1))
                                  (do
                                    (store_put kv k (dict ("val" (to_string next_val))))
                                    (print next_val)
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                      (do
                        (print "UNKNOWN CMD:" cmd)
                        (exit 1)
                      )
                    )
                  )
                )
              )
            )
            (set i (+ i 1))
          )
        )
      )
    )
  )
)
