(do
  (store_open kv "memory://session")
  (let (a (cli_args) i 0)
    (while (< i (list_len a))
      (do
        (let (c (list_get a i))
          (cond
            ((= c "set")
              (do (set i (+ i 2)) (sput kv (list_get a (- i 1)) (list_get a i)) (print "OK")))
            ((= c "get")
              (do (set i (+ i 1))
                (let (v (sget kv (list_get a i)))
                  (if (is_nil v) (print "NOT FOUND") (print v)))))
            ((= c "delete")
              (do (set i (+ i 1)) (store_delete kv (list_get a i)) (print "OK")))
            ((= c "increment")
              (do (set i (+ i 1)) (sinc kv (list_get a i))))
            (else (do (print "UNKNOWN CMD:" c) (exit 1)))))
        (set i (+ i 1))))))
