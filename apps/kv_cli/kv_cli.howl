(cli_app
  (store_open kv "memory://session")
  (let (i 0)
    (let (cmd (cli_args i))
      (while (!= cmd "")
        (do
          (if (= cmd "set")
            (do
              (set i (+ i 1))
              (let (k (cli_args i))
                (do
                  (set i (+ i 1))
                  (let (v (cli_args i))
                    (do
                      (store_put kv k (dict ("val" v)))
                      (print "OK")
                    )
                  )
                )
              )
            )
            (if (= cmd "get")
              (do
                (set i (+ i 1))
                (let (k (cli_args i))
                  (let (record (store_get kv k))
                    (if (= (to_string record) "<nil>")
                      (print "NOT FOUND")
                      (let (v (map_get record "val"))
                        (print v)
                      )
                    )
                  )
                )
              )
              (if (= cmd "delete")
                (do
                  (set i (+ i 1))
                  (let (k (cli_args i))
                    (do
                      (store_delete kv k)
                      (print "OK")
                    )
                  )
                )
                (if (= cmd "increment")
                  (do
                    (set i (+ i 1))
                    (let (k (cli_args i))
                      (let (record (store_get kv k))
                        (let (current 0)
                          (do
                            (if (!= (to_string record) "<nil>")
                              (let (val_str (map_get record "val"))
                                (set current (to_int val_str))
                              )
                            )
                            (let (next_val (+ current 1))
                              (do
                                (store_put kv k (dict ("val" (to_string next_val))))
                                (print next_val)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                  (do
                    (print "UNKNOWN CMD:" cmd)
                    (exit 1)
                  )
                )
              )
            )
          )
          (set i (+ i 1))
          (set cmd (cli_args i))
        )
      )
    )
  )
)
