(cli_app
  (let (proposal_path (cli_args 0))
    (if (= proposal_path "")
      (do
        (stderr "usage: release_authority <proposal.json> [evidence...]")
        (exit 2))
      (try_let (content_bytes (read_file proposal_path))
        (catch err
          (do
            (stderr "Failed to read proposal file")
            (exit 3)))
        (let (content (bytes_to_string content_bytes))
          (try_let (proposal (parse_json Proposal content))
            (catch err
              (do
                (stderr "Failed to parse proposal")
                (exit 3)))
            (let (action (map_get proposal "action"))
              (do
                (if (is_nil action)
                  (set action "unknown")
                )
                (let (target (map_get proposal "target"))
                  (do
                    (if (is_nil target)
                      (set target "unknown")
                    )
                    (let (tests "FAIL")
                      (let (security "FAIL")
                        (let (change_window "CLOSED")
                          (let (trusted_approval "no")
                            (do
                              (for arg (cli_args)
                                (let (parts (str_split arg "="))
                                  (let (key "")
                                    (let (val "")
                                      (let (i 0)
                                        (do
                                          (for p parts
                                            (do
                                              (if (= i 0) (set key p))
                                              (if (= i 1) (set val p))
                                              (set i (+ i 1))))
                                          (if (= key "tests") (set tests val))
                                          (if (= key "security") (set security val))
                                          (if (= key "change_window") (set change_window val))
                                          (if (= key "approved") (set trusted_approval val))
                                        ))))))

                              (let (decision "DENY")
                                (let (reason "unknown action")
                                  (do
                                    (if (= action "inspect")
                                      (do
                                        (set decision "ALLOW")
                                        (set reason "inspection is always allowed")
                                      )
                                    )
                                    (if (= action "deploy_staging")
                                      (if (and (= tests "PASS") (= security "PASS"))
                                        (if (= trusted_approval "yes")
                                          (do
                                            (set decision "ALLOW")
                                            (set reason "tests and security passed, and approved")
                                          )
                                          (do
                                            (set decision "REQUIRE_APPROVAL")
                                            (set reason "tests and security passed, but missing approval")
                                          )
                                        )
                                        (do
                                          (set decision "DENY")
                                          (set reason "tests and security must pass")
                                        )
                                      )
                                    )
                                    (if (= action "deploy_production")
                                      (if (and (= tests "PASS") (and (= security "PASS") (= change_window "OPEN")))
                                        (if (= trusted_approval "yes")
                                          (do
                                            (set decision "ALLOW")
                                            (set reason "all evidence passed and approved")
                                          )
                                          (do
                                            (set decision "REQUIRE_APPROVAL")
                                            (set reason "production deployment requires trusted approval")
                                          )
                                        )
                                        (do
                                          (set decision "DENY")
                                          (set reason "security evidence is not PASS or change window closed")
                                        )
                                      )
                                    )
                                    (if (= action "rollback")
                                      (if (= trusted_approval "yes")
                                        (do
                                          (set decision "ALLOW")
                                          (set reason "rollback approved")
                                        )
                                        (do
                                          (set decision "REQUIRE_APPROVAL")
                                          (set reason "rollback requires trusted approval")
                                        )
                                      )
                                    )

                                    (print "{")
                                    (print (str_join (list "  \"decision\": \"" decision "\",") ""))
                                    (print (str_join (list "  \"action\": \"" (to_string action) "\",") ""))
                                    (print (str_join (list "  \"target\": \"" (to_string target) "\",") ""))
                                    (print (str_join (list "  \"reason\": \"" reason "\"") ""))
                                    (print "}")

                                    (if (= decision "ALLOW")
                                      (if (!= action "inspect")
                                        (do
                                          (store_open kv "memory://release_state")
                                          (if (= action "deploy_staging")
                                            (store_put kv "state" (dict ("val" "staging_deployed")))
                                          )
                                          (if (= action "deploy_production")
                                            (store_put kv "state" (dict ("val" "production_deployed")))
                                          )
                                          (if (= action "rollback")
                                            (store_put kv "state" (dict ("val" "rolled_back")))
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
