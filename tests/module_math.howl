(module
	(export (defun add_one (n)
		(type_hint n "int")
		(type_hint return "int")
		(return (call bump n))
	))
	(export (defun double (n)
		(type_hint n "int")
		(type_hint return "int")
		(return (* n 2))
	))
	(defun bump (n)
		(type_hint n "int")
		(type_hint return "int")
		(return (+ n 1))
	)
)
