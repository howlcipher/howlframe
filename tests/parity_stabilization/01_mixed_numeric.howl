(cli_app
  (do
    (print "add:" (+ 1 2.5) (+ 2.5 1) (+ 1 2))
    (print "sub:" (- 3 0.5) (- 3.5 1) (- 3 1))
    (print "mul:" (* 2 1.5) (* 1.5 2) (* 2 3))
    (print "div:" (/ 9 2) (/ 9 2.0) (/ 9.0 2) (/ 9.0 2.0))
    (print "eq:" (= 2 2.0) (!= 2 2.5))
    (print "order:" (< 1 1.5) (<= 2 2.0) (>= 2.5 2) (> 2 2.5))
    (print "trunc:" (to_int (/ 9 2)) (to_int 3.9) (to_float 7))))
