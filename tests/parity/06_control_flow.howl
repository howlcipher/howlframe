(cli_app
  (defun add_values (a b)
    (type_hints (a int) (b int) (return int))
    (return (+ a b)))
  (defun check_sign (n)
    (type_hints (n int) (return string))
    (if (< n 0)
      (return "negative")
      (if (> n 0)
        (return "positive")
        (return "zero"))))
  (let (sum (call add_values 15 27))
    (let (count 0)
      (let (acc 0)
        (do
          (print "fn call sum:" sum)
          (print "check_sign -5:" (call check_sign -5))
          (print "check_sign 10:" (call check_sign 10))
          (print "check_sign 0:" (call check_sign 0))
          (while (< count 3)
            (do
              (set count (+ count 1))
              (set acc (+ acc count))))
          (print "while final acc:" acc count)
          (let (total 0)
            (do
              (for item (list "1" "2" "3" "4")
                (set total (+ total (to_int item))))
              (print "for total:" total))))))))
