(cli_app
  (let (items (list "alpha" "beta" "gamma"))
    (let (d (dict ("k1" "v1") ("k2" "v2")))
      (do
        (print "list_len:" (list_len items))
        (print "list_get 0:" (list_get items 0))
        (print "list_get 1:" (list_get items 1))
        (print "list_get 2:" (list_get items 2))
        (print "list_get out:" (list_get items 99))
        (append items "delta")
        (print "after append len:" (list_len items))
        (print "map_get k1:" (map_get d "k1"))
        (print "map_get k2:" (map_get d "k2"))
        (print "map_get missing:" (map_get d "missing"))
        (map_set d "k3" "v3")
        (print "map_get k3:" (map_get d "k3"))
        (map_delete d "k1")
        (print "after delete k1:" (map_get d "k1"))
        (print "is_nil string:" (is_nil "hello"))
        (print "is_nil list:" (is_nil items))))))
