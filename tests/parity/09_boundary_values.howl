(cli_app
  (let (empty_str "")
    (let (zero_val 0)
      (let (false_val false)
        (let (empty_l (list))
          (let (empty_d (dict))
            (do
              (print "empty str len:" (= empty_str ""))
              (print "zero eq 0:" (== zero_val 0))
              (print "false eq false:" (== false_val false))
              (print "empty list len:" (list_len empty_l))
              (print "missing map key:" (map_get empty_d "nope"))
              (print "out of bound list:" (list_get empty_l 0))
              (if (= empty_str "")
                (print "empty string branch ok"))
              (if (== zero_val 0)
                (print "zero branch ok"))
              (if (!= false_val true)
                (print "false branch ok")))))))))
