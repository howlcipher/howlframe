(cli_app
  (let (s "hello world")
    (let (i 42)
      (let (f 3.14)
        (let (b true)
          (let (sum (+ 10 20))
            (let (diff (- 50 15))
              (let (prod (* 6 7))
                (let (quot (/ 100 4))
                  (let (concat (+ "foo" "bar"))
                    (do
                      (print s)
                      (print i)
                      (print f)
                      (print b)
                      (print sum diff prod quot)
                      (print concat))))))))))))
