(cli_app
  (defun probe (passes)
    (type_hints (passes int) (return int))
    (let (names (list "a" "b"))
      (let (total 0)
        (let (n 0)
          (do
            (while (< n passes)
              (do
                (for label (list "L")
                  (if (= label "skip")
                    (do
                      (print (env "HOWLFRAME_ABI_SKIP"))
                      (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-hostread-skip.txt")))
                      (print "no"))
                    (do
                      (print (env "HOWLFRAME_ABI_SECRET"))
                      (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-hostread-read.txt")))
                      (for name names
                        (if (= name "z")
                          (do
                            (print (env "HOWLFRAME_ABI_ELSE"))
                            (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-hostread-else.txt")))
                            (print "no"))
                          (do
                            (set total (+ total 1))
                            (print label name n))))
                      (for absent (list)
                        (do
                          (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-hostread-empty.txt")))
                          (print "no")))
                      (while false
                        (do
                          (print (env "HOWLFRAME_ABI_DEAD"))
                          (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-hostread-dead.txt")))
                          (print "no"))))))
                (set n (+ n 1))))
            (if (> total 0)
              (do
                (print "kept" total)
                (print (env "HOWLFRAME_ABI_SECRET")))
              (do
                (print "miss")
                (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-hostread-miss.txt")))))
            (return total))))))
  (print "result" (call probe 1))
  (print "empty" (call probe 0)))
