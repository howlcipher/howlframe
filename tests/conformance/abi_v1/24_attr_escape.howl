(cli_app
  (print (attr_escape "&"))
  (print (attr_escape "<"))
  (print (attr_escape ">"))
  (print (attr_escape "\""))
  (print (attr_escape "'"))
  (print (attr_escape "&<>\"'"))
  (print (str_join (list "[" (attr_escape "") "]") ""))
  (let (title "x<y&z")
    (print (attr_escape title)))
  (if false
    (print (attr_escape "<untaken>"))
    (print (attr_escape "a&b")))
  (defun esc (text)
    (type_hint return "string")
    (return (attr_escape text)))
  (print (call esc "c<d"))
  (let (n 0)
    (while (< n 1)
      (do
        (print (attr_escape "e>f"))
        (set n (+ n 1)))))
  (for item (list "g\"h")
    (print (attr_escape item))))
