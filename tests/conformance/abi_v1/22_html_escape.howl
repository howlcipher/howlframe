(cli_app
  (print (html_escape "&"))
  (print (html_escape "<"))
  (print (html_escape ">"))
  (print (html_escape "\""))
  (print (html_escape "'"))
  (print (html_escape "&<>\"'"))
  (print (str_join (list "[" (html_escape "") "]") ""))
  (let (title "x<y&z")
    (print (html_escape title)))
  (if false
    (print (html_escape "<untaken>"))
    (print (html_escape "a&b")))
  (defun esc (text)
    (type_hint return "string")
    (return (html_escape text)))
  (print (call esc "c<d"))
  (let (n 0)
    (while (< n 1)
      (do
        (print (html_escape "e>f"))
        (set n (+ n 1)))))
  (for item (list "g\"h")
    (print (html_escape item))))
