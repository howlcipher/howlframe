(cli_app
  (defun probe (passes)
    (type_hints (passes int) (return int))
    (let (names (list "a" "b"))
      (let (total 0)
        (let (n 0)
          (do
            (while (< n passes)
              (do
                (for label (list "L")
                  (if (= label "skip")
                    (do
                      (print (env "HOWLFRAME_ABI_SKIP"))
                      (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-multi-skip-read.txt")))
                      (write_file "/tmp/howlframe-abi-v1-multi-skip-write.txt" "no")
                      (mkdir "/tmp/howlframe-abi-v1-multi-skip-dir")
                      (print (bytes_to_string (exec "printf" "no-skip")))
                      (print (bytes_to_string (fetch "http://127.0.0.1:47653/howlframe-abi-v1-phase2d" "GET")))
                      (print "no"))
                    (do
                      (print (env "HOWLFRAME_ABI_SECRET"))
                      (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-multi-read.txt")))
                      (write_file "/tmp/howlframe-abi-v1-multi-write.txt" "multi-write-marker")
                      (mkdir "/tmp/howlframe-abi-v1-multi-dir")
                      (print (bytes_to_string (exec "printf" "phase2b-exec-marker")))
                      (print (bytes_to_string (fetch "http://127.0.0.1:47653/howlframe-abi-v1-phase2d" "GET")))
                      (for name names
                        (if (= name "z")
                          (do
                            (print (env "HOWLFRAME_ABI_ELSE"))
                            (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-multi-else-read.txt")))
                            (write_file "/tmp/howlframe-abi-v1-multi-else-write.txt" "no")
                            (mkdir "/tmp/howlframe-abi-v1-multi-else-dir")
                            (print (bytes_to_string (exec "printf" "no-else")))
                            (print (bytes_to_string (fetch "http://127.0.0.1:47653/howlframe-abi-v1-phase2d" "GET")))
                            (print "no"))
                          (do
                            (set total (+ total 1))
                            (print label name n))))
                      (for absent (list)
                        (do
                          (print (env "HOWLFRAME_ABI_EMPTY"))
                          (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-multi-empty-read.txt")))
                          (write_file "/tmp/howlframe-abi-v1-multi-empty-write.txt" "no")
                          (mkdir "/tmp/howlframe-abi-v1-multi-empty-dir")
                          (print (bytes_to_string (exec "printf" "no-empty")))
                          (print (bytes_to_string (fetch "http://127.0.0.1:47653/howlframe-abi-v1-phase2d" "GET")))
                          (print "no")))
                      (while false
                        (do
                          (print (env "HOWLFRAME_ABI_DEAD"))
                          (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-multi-dead-read.txt")))
                          (write_file "/tmp/howlframe-abi-v1-multi-dead-write.txt" "no")
                          (mkdir "/tmp/howlframe-abi-v1-multi-dead-dir")
                          (print (bytes_to_string (exec "printf" "no-dead")))
                          (print (bytes_to_string (fetch "http://127.0.0.1:47653/howlframe-abi-v1-phase2d" "PUT" "phase2d-body-not-sent")))
                          (print "no"))))))
                (set n (+ n 1))))
            (if (> total 0)
              (do
                (print "kept" total)
                (print (env "HOWLFRAME_ABI_SECRET"))
                (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-multi-kept-read.txt")))
                (write_file "/tmp/howlframe-abi-v1-multi-kept-write.txt" "multi-kept-write")
                (mkdir "/tmp/howlframe-abi-v1-multi-kept-dir")
                (print (bytes_to_string (exec "printf" "phase2b-exec-kept")))
                (print (bytes_to_string (fetch "http://127.0.0.1:47653/howlframe-abi-v1-phase2d" "GET"))))
              (do
                (print "miss")
                (print (env "HOWLFRAME_ABI_SECRET"))
                (print (bytes_to_string (read_file "/tmp/howlframe-abi-v1-multi-miss-read.txt")))
                (write_file "/tmp/howlframe-abi-v1-multi-miss-write.txt" "multi-miss-write")
                (mkdir "/tmp/howlframe-abi-v1-multi-miss-dir")
                (print (bytes_to_string (exec "printf" "phase2b-exec-miss")))
                (print (bytes_to_string (fetch "http://127.0.0.1:47653/howlframe-abi-v1-phase2d" "GET")))))
            (return total))))))
  (print "result" (call probe 1))
  (print "empty" (call probe 0)))
