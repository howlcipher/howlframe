; Fresh requirements-first Ticketdesk candidate, 2026-10-20.
; Each bucket contains its records and order together: one atomic store write
; publishes a create, patch or delete. There is no separately persisted live index.
(http_server (call initialize)
  (serialize_requests)
  (grants "database" "inherit:filesystem")

  (defun abort_start ((status int) (message string)) int
    (do (stderr (str "ticketdesk: " message "\n")) (exit status) (return 0)))

  (defun kind ((value any)) string
    (let (text (encode_json value))
      (do
        (if (regex_match "^\"" text) (return "string"))
        (if (regex_match "^\\{" text) (return "object"))
        (if (regex_match "^\\[" text) (return "array"))
        (if (regex_match "^-?[0-9]+$" text) (return "integer"))
        (return "other"))))

  (defun initialize () int
    (let (secret "" path "" raw_port "" debug "" port 8080 parent "" state_text "")
      (do
        (try_let (settings (list (env "TICKETDESK_ADMIN_TOKEN") (env "TICKETDESK_DATA")
                                (env "TICKETDESK_PORT") (env "TICKETDESK_ALLOW_DEBUG_FAULT")))
          (catch e (call abort_start 77 "capability denied: environment"))
          (do (set secret (list_get settings 0)) (set path (list_get settings 1))
              (set raw_port (list_get settings 2)) (set debug (list_get settings 3))))
        (if (not (regex_match "^[\\x21-\\x7e]{16,256}$" secret))
          (call abort_start 2 "TICKETDESK_ADMIN_TOKEN must contain 16..256 non-space ASCII characters"))
        (if (or (= path "") (not (starts_with path "/")))
          (call abort_start 2 "TICKETDESK_DATA must be an absolute path"))
        (if (!= raw_port "")
          (do
            (if (not (regex_match "^[0-9]{1,5}$" raw_port)) (call abort_start 2 "invalid port"))
            (set port (to_int raw_port))
            (if (or (< port 1) (> port 65535)) (call abort_start 2 "invalid port"))))
        (set parent (str_join (list_slice (str_split path "/") 0 -1) "/"))
        (if (= parent "") (set parent "/"))
        (try_let (directory (read_file parent))
          (catch e
            (do
              (if (str_contains e "CAPABILITY_DENIED") (call abort_start 77 "capability denied: filesystem"))
              (if (str_contains e "no such file") (call abort_start 66 "data directory does not exist"))))
          (set directory directory))
        (try_let (bytes (read_file path))
          (catch e
            (do
              (if (str_contains e "CAPABILITY_DENIED") (call abort_start 77 "capability denied: filesystem"))
              (if (not (str_contains e "no such file")) (call abort_start 65 "data file cannot be read"))))
          (set state_text (bytes_to_string bytes)))
        ; JSON syntax is inspectable with the read grant even when database is
        ; absent; preserve the specified data-error-before-grant precedence.
        (if (!= state_text "")
          (try_let (document (parse_json Any state_text))
            (catch e (call abort_start 65 "invalid state JSON"))
            (do
              (if (!= (call kind document) "object") (call abort_start 65 "invalid state object"))
              (if (not (call validate_document document)) (call abort_start 65 "invalid state records")))))
        ; Validate before any mutation or grant/port rejection. A new format is
        ; explicit: old state is never silently reinterpreted as empty state.
        (try_let (opened (call open_disk path))
          (catch e
            (if (str_contains e "CAPABILITY_DENIED")
              (call abort_start 77 "capability denied: database or filesystem")
              (call abort_start 65 "invalid state file")))
          (let (header (store_get opened "header"))
            (do
              (if (is_nil header)
                (if (> (list_len (store_keys opened)) 0) (call abort_start 65 "state format requires migration"))
                (do
                  (if (!= (call kind header) "object") (call abort_start 65 "invalid state header"))
                  (if (!= (map_get header "version") 2) (call abort_start 65 "unsupported state version"))
                  (if (!= (call kind (map_get header "next")) "integer") (call abort_start 65 "invalid ticket counter"))
                  (if (< (map_get header "next") 1) (call abort_start 65 "invalid ticket counter"))))
              (if (not (granted "network")) (call abort_start 77 "capability denied: network"))
              (if (not (port_available port)) (call abort_start 1 "port is already in use"))
              (try_let (written (call prepare_disk opened header))
                (catch e
                  (if (str_contains e "CAPABILITY_DENIED")
                    (call abort_start 77 "capability denied: filesystem")
                    (call abort_start 73 "cannot write state")))
                (set written written)))))
        (store_open settings "memory://ticketdesk-v2")
        (store_put settings "config" (dict ("path" path) ("bootstrap" (sha256_hex secret)) ("debug" debug)))
        (return port))))

  (defun open_disk ((path string)) any
    (do (store_open disk (str "file://" path)) (return disk)))

  ; Reject structurally corrupt state before writing. Entity checks also prove
  ; that counters cannot reuse a live id and list/GET membership cannot disagree.
  (defun valid_ticket ((record any) (id string)) bool
    (do
      (if (!= (call kind record) "object") (return false))
      (if (or (!= (map_get record "id") id) (!= (list_len (map_keys record)) 8)) (return false))
      (for name (list "title" "body" "owner")
        (if (!= (call kind (map_get record name)) "string") (return false)))
      (if (or (= (list_len (map_get record "title")) 0) (= (list_len (map_get record "owner")) 0)) (return false))
      (if (> (str_len (map_get record "title")) 120) (return false))
      (if (> (str_len (map_get record "body")) 4000) (return false))
      (if (not (list_contains (list "low" "normal" "high") (map_get record "priority"))) (return false))
      (if (not (list_contains (list "open" "in_progress" "done") (map_get record "status"))) (return false))
      (for name (list "created_at" "updated_at")
        (if (!= (call kind (map_get record name)) "integer") (return false)))
      (return (and (> (map_get record "created_at") 0) (>= (map_get record "updated_at") (map_get record "created_at"))))))

  (defun valid_bucket ((group any) (key string) (next int)) bool
    (do
      (if (not (regex_match "^bucket:[0-9]{12,15}$" key)) (return false))
      (if (or (!= (call kind (map_get group "order")) "array")
              (!= (call kind (map_get group "records")) "object")) (return false))
      (let (order (map_get group "order") records (map_get group "records") previous 0 expected (to_int (str_slice key 7)))
        (do
          (if (or (!= (list_len order) (list_len (map_keys records))) (!= key (call bucket_name (* expected 64)))) (return false))
          (for id order
            (do
              (if (!= (call kind id) "string") (return false))
              (let (number (call sequence id))
                (do
                  (if (or (<= number previous) (!= expected (to_int (/ number 64))) (>= number next)) (return false))
                  (if (not (call valid_ticket (map_get records id) id)) (return false))
                  (set previous number)))))
          (return true)))))

  (defun valid_tokens ((group any)) bool
    (do
      (if (or (!= (call kind (map_get group "order")) "array")
              (!= (call kind (map_get group "records")) "object")) (return false))
      (let (order (map_get group "order") records (map_get group "records") seen (dict) digests (dict))
        (do
          (if (!= (list_len order) (list_len (map_keys records))) (return false))
          (for id order
            (do
              (if (!= (call kind id) "string") (return false))
              (if (or (not (regex_match "^tok_[0-9a-f]{16}$" id)) (map_has seen id)) (return false))
              (let (record (map_get records id))
                (do
                  (if (!= (call kind record) "object") (return false))
                  (if (!= (map_get record "id") id) (return false))
                  (if (!= (call kind (map_get record "name")) "string") (return false))
                  (if (or (= (list_len (map_get record "name")) 0) (> (str_len (map_get record "name")) 64)) (return false))
                  (if (not (list_contains (list "admin" "member" "viewer") (map_get record "role"))) (return false))
                  (if (not (regex_match "^(true|false)$" (encode_json (map_get record "revoked")))) (return false))
                  (if (!= (call kind (map_get record "created_at")) "integer") (return false))
                  (if (< (map_get record "created_at") 1) (return false))
                  (let (digest (map_get record "digest"))
                    (do
                      (if (!= (call kind digest) "string") (return false))
                      (if (or (not (regex_match "^[0-9a-f]{64}$" digest)) (map_has digests digest)) (return false))
                      (map_set digests digest 1)))
                  (map_set seen id 1)))))
          (return true)))))

  (defun validate_document ((document dict)) bool
    (let (header (map_get document "header"))
      (do
        (if (is_nil header) (return (= (list_len (map_keys document)) 0)))
        (if (!= (call kind header) "object") (return false))
        (if (or (!= (map_get header "version") 2) (!= (call kind (map_get header "next")) "integer")) (return false))
        (if (< (map_get header "next") 1) (return false))
        (for key (map_keys document)
          (do
            (if (starts_with key "bucket:")
              (if (not (call valid_bucket (map_get document key) key (map_get header "next"))) (return false)))
            (if (= key "tokens")
              (if (not (call valid_tokens (map_get document key))) (return false)))
            (if (and (!= key "header") (!= key "tokens") (not (starts_with key "bucket:"))) (return false))))
        (return true))))

  (defun prepare_disk ((disk any) (header any)) int
    (do
      (store_put disk "header" (if (is_nil header) (dict ("version" 2) ("next" 1)) header))
      (return 0)))

  (defun configuration () dict
    (do (store_open settings "memory://ticketdesk-v2") (return (store_get settings "config"))))

  (defun storage () any
    (return (call open_disk (map_get (call configuration) "path"))))

  (defun fail_response ((req any) (status int) (code string) (message string)) int
    (do (res_json status (dict ("error" (dict ("code" code) ("message" message) ("request_id" (req_id req)))))) (return 0)))

  (defun invalid_fields ((req any) (fields list)) int
    (do
      (res_json 400 (dict ("error" (dict ("code" "validation_failed") ("message" "Request validation failed.")
        ("request_id" (req_id req)) ("fields" fields)))))
      (return 0)))

  (defun violation ((name string) (code string)) dict
    (return (dict ("field" name) ("code" code) ("message" (str name ": " code)))))

  (defun unauthenticated ((req any)) int
    (do (res_header "WWW-Authenticate" "Bearer realm=\"ticketdesk\"")
      (return (call fail_response req 401 "unauthorized" "Invalid or missing credentials."))))

  (defun identity ((req any)) dict
    (let (header (req_header req "Authorization"))
      (do
        (if (not (regex_match "^(?i:bearer) [!-~]+$" header)) (return (dict)))
        (let (digest (sha256_hex (str_slice header 7)) cfg (call configuration))
          (do
            (if (secure_equal digest (map_get cfg "bootstrap"))
              (return (dict ("id" "bootstrap") ("name" "bootstrap") ("role" "admin"))))
            (let (disk (call storage))
              (let (group (call token_group disk))
                (let (records (map_get group "records"))
                  (do
                    (for id (map_get group "order")
                      (let (record (map_get records id))
                        (if (and (not (map_get record "revoked")) (secure_equal digest (map_get record "digest")))
                          (return (dict ("id" id) ("name" (map_get record "name")) ("role" (map_get record "role")))))))
                    (return (dict)))))))))))

  ; Validation is shared by create/update/token requests. Values remain literal;
  ; every bad field is collected and each field has one first violation.
  (defun validate ((req any) (mode string)) dict
    (let (parts (str_split (req_header req "Content-Type") ";"))
      (let (media (to_lower (ltrim (rtrim (list_get parts 0)))))
      (do
        (if (!= media "application/json")
          (do (call fail_response req 415 "unsupported_media_type" "Expected application/json.") (return (dict))))
        (try_let (raw (req_body req))
          (catch e
            (do
              (if (str_contains e "LIMIT_EXCEEDED")
                (call fail_response req 413 "payload_too_large" "Request body exceeds the configured limit.")
                (call fail_response req 400 "invalid_json" "Request body is not valid JSON."))
              (return (dict))))
          (do
            (if (not (utf8_valid raw))
              (do (call fail_response req 400 "invalid_json" "Request body is not valid JSON.") (return (dict))))
            (try_let (document (parse_json Any raw))
              (catch e
                (do (call fail_response req 400 "invalid_json" "Request body is not valid JSON.") (return (dict))))
              (do
                (if (!= (call kind document) "object")
                  (do (call invalid_fields req (list (call violation "$" "invalid_type"))) (return (dict))))
                (let (errors (list) allowed (list "title" "body" "priority") mandatory (list))
                  (do
                    (if (= mode "create") (set mandatory (list "title")))
                    (if (= mode "patch") (set allowed (list "title" "body" "priority" "status")))
                    (if (= mode "token") (do (set allowed (list "name" "role")) (set mandatory (list "name" "role"))))
                    (for name mandatory
                      (if (not (map_has document name)) (append errors (call violation name "required"))))
                    (if (and (= mode "patch") (= (list_len (map_keys document)) 0))
                      (append errors (call violation "$" "required")))
                    (for name (map_keys document)
                      (let (value (map_get document name) code "")
                        (do
                          (if (not (list_contains allowed name))
                            (set code "unknown_field")
                            (if (!= (call kind value) "string")
                              (set code "invalid_type")
                              (if (list_contains (list "title" "body" "name") name)
                                (let (maximum (if (= name "title") 120 (if (= name "name") 64 4000)))
                                  (do
                                    (if (and (!= name "body") (= (list_len value) 0)) (set code "too_short"))
                                    (if (and (> (list_len value) maximum) (> (str_len value) maximum)) (set code "too_long"))))
                                (if (not (list_contains
                                      (if (= name "role") (list "admin" "member" "viewer")
                                        (if (= name "priority") (list "low" "normal" "high") (list "open" "in_progress" "done"))) value))
                                  (set code "invalid_value")))))
                          (if (!= code "") (append errors (call violation name code))))))
                    (if (> (list_len errors) 0)
                      (do (call invalid_fields req errors) (return (dict))))
                    (return (dict ("document" document)))))))))
        (return (dict))))))

  (defun bucket_name ((number int)) string
    (return (str "bucket:" (pad_left (to_string (to_int (/ number 64))) 12 "0"))))

  (defun sequence ((id string)) int
    (do
      (if (not (regex_match "^t[1-9][0-9]{0,14}$" id)) (return 0))
      (return (to_int (str_slice id 1)))))

  (defun bucket ((disk any) (number int)) dict
    (let (value (store_get disk (call bucket_name number)))
      (return (if (is_nil value) (dict ("order" (list)) ("records" (dict))) value))))

  (defun read_ticket ((disk any) (id string)) any
    (do
      (if (= (call sequence id) 0) (return (map_get (dict) "absent")))
      (return (map_get (map_get (call bucket disk (call sequence id)) "records") id))))

  (defun ticket_request ((req any) (who dict) (id string)) int
    (let (disk (call storage) method (req_method req) record (call read_ticket disk id))
      (do
        (if (is_nil record) (return (call fail_response req 404 "not_found" "Ticket not found.")))
        (if (= method "GET") (do (res_json 200 record) (return 0)))
        (if (and (= method "PATCH") (!= (map_get who "role") "admin") (!= (map_get record "owner") (map_get who "id")))
          (return (call fail_response req 403 "forbidden" "You may change only your own tickets.")))
        (let (group (call bucket disk (call sequence id)))
          (let (records (map_get group "records"))
          (do
            (if (= method "DELETE")
              (do
                (let (remaining (list))
                  (do
                    (for item (map_get group "order") (if (!= item id) (append remaining item)))
                    (map_set group "order" remaining)))
                (map_delete records id)
                (store_put disk (call bucket_name (call sequence id)) group)
                (res_json 200 (dict ("id" id) ("deleted" true))) (return 0)))
            (let (checked (call validate req "patch"))
              (do
                (if (not (map_has checked "document")) (return 0))
                (let (document (map_get checked "document"))
                  (for field (map_keys document) (map_set record field (map_get document field))))
                (map_set record "updated_at" (max (list (time_now) (map_get record "updated_at"))))
                (map_set records id record)
                (store_put disk (call bucket_name (call sequence id)) group)
                (res_json 200 record)
                (return 0)))))))))

  (defun create_ticket ((req any) (who dict)) int
    (let (checked (call validate req "create"))
      (do
        (if (not (map_has checked "document")) (return 0))
        (let (disk (call storage) document (map_get checked "document"))
          (let (header (store_get disk "header"))
            (let (number (map_get header "next") now (time_now))
              (let (id (str "t" number) group (call bucket disk number))
                (let (order (map_get group "order") records (map_get group "records"))
                (let (record (dict ("id" id) ("title" (map_get document "title")) ("body" (nz (map_get document "body") ""))
                       ("priority" (nz (map_get document "priority") "normal")) ("status" "open")
                       ("owner" (map_get who "id")) ("created_at" now) ("updated_at" now)))
                  (do
                    ; Reserve first. A crash can burn an unused id but cannot
                    ; publish a record without publishing its list membership.
                    (map_set header "next" (+ number 1)) (store_put disk "header" header)
                    (append order id)
                    (map_set group "order" order)
                    (map_set records id record)
                    (store_put disk (call bucket_name number) group)
                    (res_header "Location" (str "/v1/tickets/" id))
                    (res_json 201 record) (return 0)))))))))))

  (defun list_tickets ((req any)) int
    (let (limit_raw (req_query req "limit") filter (req_query req "status") cursor (req_query req "cursor")
          limit 20 after 0 errors (list))
      (do
        (if (!= limit_raw "")
          (if (not (regex_match "^0*[1-9][0-9]{0,2}$" limit_raw))
            (append errors (call violation "limit" "invalid_value"))
            (if (> (to_int limit_raw) 100) (append errors (call violation "limit" "invalid_value")) (set limit (to_int limit_raw)))))
        (if (and (!= filter "") (not (list_contains (list "open" "in_progress" "done") filter)))
          (append errors (call violation "status" "invalid_value")))
        (if (!= cursor "")
          (if (not (regex_match "^[A-Za-z0-9_-]{1,64}$" cursor))
            (append errors (call violation "cursor" "invalid_value"))
            (if (regex_match "^[0-9]{1,15}$" cursor) (set after (to_int cursor)))))
        (if (> (list_len errors) 0) (return (call invalid_fields req errors)))
        (let (disk (call storage) items (list) last 0 has_more false)
          (do
            (for key (store_keys disk)
              (if (and (starts_with key "bucket:") (>= key (call bucket_name after)) (not has_more))
                (let (group (store_get disk key))
                  (for id (map_get group "order")
                    (if (and (> (call sequence id) after) (not has_more))
                      (let (record (map_get (map_get group "records") id))
                        (if (or (= filter "") (= filter (map_get record "status")))
                          (if (= (list_len items) limit) (set has_more true)
                            (do (append items record) (set last (call sequence id)))))))))))
            (res_json 200 (dict ("items" items) ("next_cursor" (if has_more (to_string last) (map_get (dict) "nil")))))
            (return 0))))))

  (defun public_token ((record dict)) dict
    (return (dict ("id" (map_get record "id")) ("name" (map_get record "name")) ("role" (map_get record "role"))
      ("created_at" (map_get record "created_at")) ("revoked" (map_get record "revoked")))))

  ; Tokens, their creation order, and revocation live in one atomic record.
  ; A crash cannot strand a token between canonical and hash-index writes.
  (defun token_group ((disk any)) dict
    (let (group (store_get disk "tokens"))
      (return (if (is_nil group) (dict ("order" (list)) ("records" (dict))) group))))

  (defun token_request ((req any) (id string)) int
    (let (disk (call storage) method (req_method req))
      (let (group (call token_group disk))
        (let (records (map_get group "records") order (map_get group "order"))
          (do
            (if (= method "DELETE")
              (do
                (if (= id "bootstrap") (return (call fail_response req 409 "conflict" "The bootstrap token cannot be revoked.")))
                (let (record (map_get records id))
                  (do
                    (if (is_nil record) (return (call fail_response req 404 "not_found" "Token not found.")))
                    (map_set record "revoked" true)
                    (map_set records id record)
                    (store_put disk "tokens" group)
                    (res_json 200 (call public_token record)) (return 0)))))
            (if (= method "POST")
              (let (checked (call validate req "token"))
                (do
                  (if (not (map_has checked "document")) (return 0))
                  (let (document (map_get checked "document") secret (str "td_" (rand_hex 32)) new_id (str "tok_" (rand_hex 8)))
                    (let (record (dict ("id" new_id) ("name" (map_get document "name")) ("role" (map_get document "role"))
                           ("created_at" (time_now)) ("revoked" false) ("digest" (sha256_hex secret))))
                      (do
                        (if (map_has records new_id) (return (call fail_response req 500 "internal_error" "An internal error occurred.")))
                        (map_set records new_id record)
                        (append order new_id)
                        (map_set group "order" order)
                        (store_put disk "tokens" group)
                        (let (response (call public_token record))
                          (do
                            (map_set response "token" secret)
                            (res_header "Location" (str "/v1/tokens/" new_id)) (res_header "Cache-Control" "no-store")
                            (res_json 201 response) (return 0)))))))))
            (let (items (list))
              (do
                (for token_id order (append items (call public_token (map_get records token_id))))
                (res_json 200 (dict ("items" items))) (return 0))))))))

  (defun dispatch_request ((req any) (resource string) (allowed string)) int
    (let (method (req_method req))
      (do
        (if (= resource "missing") (return (call fail_response req 404 "not_found" "Route not found.")))
        (if (= (map_get (call configuration) "debug") "1")
          (if (= (req_header req "X-Debug-Fault") "1") (return (call report_fault req (to_int "deliberate-fault")))))
        (if (not (list_contains (str_split allowed ", ") method))
          (do (res_header "Allow" allowed) (return (call fail_response req 405 "method_not_allowed" "Method not allowed."))))
        (if (= resource "health") (do (res_json 200 (dict ("status" "ok"))) (return 0)))
        (let (who (call identity req))
          (do
            (if (= (list_len (map_keys who)) 0) (return (call unauthenticated req)))
            (if (= resource "me") (do (res_json 200 who) (return 0)))
            (let (role (map_get who "role"))
              (do
                (if (or (starts_with resource "token") (and (= resource "ticket") (= method "DELETE")))
                  (if (!= role "admin") (return (call fail_response req 403 "forbidden" "Administrator role required."))))
                (if (and (= role "viewer") (list_contains (list "POST" "PATCH") method))
                  (return (call fail_response req 403 "forbidden" "This role cannot modify tickets.")))
                (if (= resource "tickets")
                  (return (if (= method "GET") (call list_tickets req) (call create_ticket req who))))
                (if (= resource "ticket") (return (call ticket_request req who (req_path req "id"))))
                (return (call token_request req (if (= resource "token") (req_path req "id") ""))))))))))

  (defun report_fault ((req any) (error any)) int
    (do
      (stderr (str "fault request_id=" (req_id req) " method=" (req_method req) " path=" (req_url_path req)
        " error=" (str_replace (to_string error) "\n" " ") "\n"))
      (return (call fail_response req 500 "internal_error" "An internal error occurred."))))

  (defun handle ((req any) (resource string) (allowed string)) void
    (try_let (result (call dispatch_request req resource allowed))
      (catch e (call report_fault req e)) (set result result)))

  (route "/v1/health" (lambda (req) (call handle req "health" "GET")))
  (route "/v1/me" (lambda (req) (call handle req "me" "GET")))
  (route "/v1/tickets" (lambda (req) (call handle req "tickets" "GET, POST")))
  (route "/v1/tickets/{id}" (lambda (req) (call handle req "ticket" "DELETE, GET, PATCH")))
  (route "/v1/tokens" (lambda (req) (call handle req "tokens" "GET, POST")))
  (route "/v1/tokens/{id}" (lambda (req) (call handle req "token" "DELETE")))
  (route "*" (lambda (req) (call handle req "missing" ""))))
